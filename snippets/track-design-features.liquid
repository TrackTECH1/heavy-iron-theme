{%- comment -%}
  Track Design Features — construction & performance highlights for rubber tracks.
{%- endcomment -%}

<div class="track-specs track-design-features">
  <table class="track-specs__table">
    <tbody>
      <tr>
        <td class="track-specs__label track-specs__label--feature">High-Traction, Low-Vibration Ride</td>
        <td class="track-specs__value">Designed to reduce harsh vibration transfer for smoother travel, improved handling, and operator comfort.</td>
      </tr>
      <tr>
        <td class="track-specs__label track-specs__label--feature">Abrasion-Resistant Rubber Compound</td>
        <td class="track-specs__value">Built to resist cuts, cracks, chunking, and premature wear in demanding jobsite conditions.</td>
      </tr>
      <tr>
        <td class="track-specs__label track-specs__label--feature">Continuously Wound Steel Cord</td>
        <td class="track-specs__value">Internal steel reinforcement helps maintain track strength, shape, and stability under load.</td>
      </tr>
      <tr>
        <td class="track-specs__label track-specs__label--feature">Forged Steel Links</td>
        <td class="track-specs__value">Precision-forged links support reliable sprocket engagement and long-term undercarriage performance.</td>
      </tr>
      <tr>
        <td class="track-specs__label track-specs__label--feature">Superior Steel Bonding</td>
        <td class="track-specs__value">Strong steel-to-rubber bonding helps reduce separation and extend service life.</td>
      </tr>
    </tbody>
  </table>
</div>
