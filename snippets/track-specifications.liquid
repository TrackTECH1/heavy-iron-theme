{%- comment -%}
  Track Specifications Table — size, rating, width, pitch, links, weight.
  Warranty & shipping live in the separate accordion below.
{%- endcomment -%}

{%- assign track_size = product.metafields.custom.track_size.value -%}
{%- assign width_mm = product.metafields.custom.width_mm.value -%}
{%- assign width_in = product.metafields.custom.width_in.value -%}
{%- assign pitch_mm = product.metafields.custom.pitch_mm.value -%}
{%- assign pitch_type = product.metafields.custom.pitch_type.value -%}
{%- assign links = product.metafields.custom.links.value -%}
{%- assign guide_type = product.metafields.custom.guide.value -%}
{%- assign warranty_months = product.metafields.custom.warranty_months.value -%}
{%- assign track_rating = product.metafields.custom.track_rating.value
  | default: product.metafields.custom.rating.value
  | default: product.metafields.custom.duty_rating.value -%}
{%- assign track_weight = product.metafields.custom.track_weight.value
  | default: product.metafields.custom.weight_lbs.value
  | default: product.metafields.custom.weight.value -%}

{%- if track_size != blank -%}
  {%- assign size_parts = track_size | split: 'x' -%}
  {%- if width_mm == blank and size_parts.size >= 1 -%}
    {%- assign width_mm = size_parts[0] | strip -%}
  {%- endif -%}
  {%- if pitch_mm == blank and size_parts.size >= 2 -%}
    {%- assign pitch_mm = size_parts[1] | strip -%}
  {%- endif -%}
  {%- if links == blank and size_parts.size >= 3 -%}
    {%- assign links = size_parts[2] | strip -%}
  {%- endif -%}
{%- endif -%}

{%- if track_rating == blank -%}
  {%- assign track_rating = 'Heavy Duty' -%}
{%- endif -%}

{%- if track_weight == blank -%}
  {%- assign spec_variant = product.selected_or_first_available_variant -%}
  {%- if spec_variant.weight > 0 -%}
    {%- assign track_weight = spec_variant.weight | divided_by: 453.592 | round -%}
  {%- endif -%}
{%- endif -%}

{%- if track_size != blank -%}
<div class="track-specs">
  <table class="track-specs__table">
    <tbody>
      <tr>
        <td class="track-specs__label">Track Size</td>
        <td class="track-specs__value track-specs__value--highlight">{{ track_size }}</td>
      </tr>
      <tr>
        <td class="track-specs__label">Rating</td>
        <td class="track-specs__value">{{ track_rating }}</td>
      </tr>
      {%- if width_mm != blank -%}
        <tr>
          <td class="track-specs__label">Width</td>
          <td class="track-specs__value">
            {{ width_mm }} mm
            {%- if width_in != blank -%}
              <span class="track-specs__muted">/ {{ width_in }} in</span>
            {%- endif -%}
          </td>
        </tr>
      {%- endif -%}
      {%- if pitch_mm != blank -%}
        <tr>
          <td class="track-specs__label">Pitch</td>
          <td class="track-specs__value">
            {{ pitch_mm }} mm
            {%- if pitch_type != blank -%}
              <span class="track-specs__muted">/ Type {{ pitch_type }}</span>
            {%- endif -%}
          </td>
        </tr>
      {%- endif -%}
      {%- if links != blank -%}
        <tr>
          <td class="track-specs__label">Links</td>
          <td class="track-specs__value">{{ links }}</td>
        </tr>
      {%- endif -%}
      {%- if guide_type != blank -%}
        <tr>
          <td class="track-specs__label">Guide</td>
          <td class="track-specs__value">{{ guide_type }}</td>
        </tr>
      {%- endif -%}
      {%- if warranty_months != blank -%}
        <tr>
          <td class="track-specs__label">Warranty</td>
          <td class="track-specs__value">{{ warranty_months }} months</td>
        </tr>
      {%- endif -%}
      {%- if track_weight != blank -%}
        {%- assign track_weight_display = track_weight | strip -%}
        {%- unless track_weight_display contains 'lb' -%}
          {%- assign track_weight_display = track_weight_display | append: 'lbs' -%}
        {%- endunless -%}
        <tr>
          <td class="track-specs__label">Weight</td>
          <td class="track-specs__value">{{ track_weight_display }}</td>
        </tr>
      {%- endif -%}
    </tbody>
  </table>
</div>
{%- endif -%}
