{%- comment -%}
  fitment-data.liquid — Single Shopify fitment source for PDP widgets.
  Reads custom.fitments first (Supabase-derived fitment MOs), then legacy
  custom.fits_equipment_models model refs, then compatible_with text.
  Params:
    - product (required)
    - output: 'rows' (default) | 'grouped' — JSON shape for consumers
{%- endcomment -%}
{%- liquid
  assign fitment_refs = product.metafields.custom.fitments.value
  assign legacy_model_refs = product.metafields.custom.fits_equipment_models.value
  assign compatible_raw = product.metafields.custom.compatible_with.value
  assign has_fitments = false
  if fitment_refs != blank and fitment_refs.size > 0
    assign has_fitments = true
  endif
  assign has_legacy_models = false
  if legacy_model_refs != blank and legacy_model_refs.size > 0
    assign has_legacy_models = true
  endif
  assign fit_output = output | default: 'rows'
-%}
{%- if fit_output == 'grouped' -%}
  {%- if has_fitments -%}
    {%- assign make_list = '' -%}
    {%- for fitment in fitment_refs -%}
      {%- assign make_mo = fitment.make.value -%}
      {%- assign make_name = make_mo.name.value | default: make_mo.display_name.value | default: make_mo.name | default: '' -%}
      {%- if make_name != blank -%}
        {%- unless make_list contains make_name -%}
          {%- if make_list != '' -%}{%- assign make_list = make_list | append: '||' -%}{%- endif -%}
          {%- assign make_list = make_list | append: make_name -%}
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
    {%- assign makes = make_list | split: '||' -%}
    {
    {%- for make in makes -%}
      {%- unless forloop.first -%},{%- endunless -%}
      {{ make | json }}:[
      {%- assign first_model = true -%}
      {%- for fitment in fitment_refs -%}
        {%- assign fmake_mo = fitment.make.value -%}
        {%- assign fmake = fmake_mo.name.value | default: fmake_mo.display_name.value | default: fmake_mo.name | default: '' -%}
        {%- if fmake == make -%}
          {%- assign model_mo = fitment.model.value -%}
          {%- assign model_display = model_mo.display_name.value | default: model_mo.display_name | default: model_mo.system.handle -%}
          {%- assign model_label = model_display | remove_first: make | remove_first: ' ' | strip -%}
          {%- if model_label == blank -%}{%- assign model_label = model_display -%}{%- endif -%}
          {%- assign model_url = model_mo.system.url | default: '' -%}
          {%- assign model_handle = model_mo.system.handle | default: '' -%}
          {%- unless first_model -%},{%- endunless -%}
          {"m":{{ model_label | json }},"h":{{ model_handle | json }},"u":{{ model_url | json }}}
          {%- assign first_model = false -%}
        {%- endif -%}
      {%- endfor -%}
      ]
    {%- endfor -%}
    }
  {%- elsif has_legacy_models -%}
    {%- assign make_list = '' -%}
    {%- for model_mo in legacy_model_refs -%}
      {%- assign make_mo = model_mo.make.value -%}
      {%- assign make_name = make_mo.name.value | default: make_mo.display_name.value | default: make_mo.name | default: '' -%}
      {%- if make_name != blank -%}
        {%- unless make_list contains make_name -%}
          {%- if make_list != '' -%}{%- assign make_list = make_list | append: '||' -%}{%- endif -%}
          {%- assign make_list = make_list | append: make_name -%}
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
    {%- assign makes = make_list | split: '||' -%}
    {
    {%- for make in makes -%}
      {%- unless forloop.first -%},{%- endunless -%}
      {{ make | json }}:[
      {%- assign first_model = true -%}
      {%- for model_mo in legacy_model_refs -%}
        {%- assign fmake_mo = model_mo.make.value -%}
        {%- assign fmake = fmake_mo.name.value | default: fmake_mo.display_name.value | default: fmake_mo.name | default: '' -%}
        {%- if fmake == make -%}
          {%- assign model_display = model_mo.display_name.value | default: model_mo.display_name | default: model_mo.system.handle -%}
          {%- assign model_label = model_display | remove_first: make | remove_first: ' ' | strip -%}
          {%- if model_label == blank -%}{%- assign model_label = model_display -%}{%- endif -%}
          {%- assign model_url = model_mo.system.url | default: '' -%}
          {%- assign model_handle = model_mo.system.handle | default: '' -%}
          {%- unless first_model -%},{%- endunless -%}
          {"m":{{ model_label | json }},"h":{{ model_handle | json }},"u":{{ model_url | json }}}
          {%- assign first_model = false -%}
        {%- endif -%}
      {%- endfor -%}
      ]
    {%- endfor -%}
    }
  {%- elsif compatible_raw != blank -%}
    {%- assign machines = compatible_raw | newline_to_br | split: '<br />' -%}
    {%- assign multi_word_makes = 'John Deere||New Holland||Ditch Witch||Wacker Neuson' -%}
    {%- assign make_list = '' -%}
    {%- for machine in machines -%}
      {%- assign trimmed = machine | strip | strip_html -%}
      {%- if trimmed == blank -%}{%- continue -%}{%- endif -%}
      {%- assign words = trimmed | split: ' ' -%}
      {%- if words.size < 2 -%}{%- continue -%}{%- endif -%}
      {%- assign first = words[0] -%}
      {%- assign second = words[1] -%}
      {%- if multi_word_makes contains first -%}
        {%- assign mk = first | append: ' ' | append: second -%}
      {%- else -%}
        {%- assign mk = first -%}
      {%- endif -%}
      {%- if mk != blank -%}
        {%- unless make_list contains mk -%}
          {%- if make_list != '' -%}{%- assign make_list = make_list | append: '||' -%}{%- endif -%}
          {%- assign make_list = make_list | append: mk -%}
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
    {%- assign makes = make_list | split: '||' -%}
    {
    {%- for make in makes -%}
      {%- unless forloop.first -%},{%- endunless -%}
      {{ make | json }}:[
      {%- assign first_model = true -%}
      {%- for machine in machines -%}
        {%- assign trimmed = machine | strip | strip_html -%}
        {%- if trimmed == blank -%}{%- continue -%}{%- endif -%}
        {%- assign words = trimmed | split: ' ' -%}
        {%- if words.size < 2 -%}{%- continue -%}{%- endif -%}
        {%- assign first = words[0] -%}
        {%- assign second = words[1] -%}
        {%- if multi_word_makes contains first -%}
          {%- assign mk = first | append: ' ' | append: second -%}
          {%- assign md = trimmed | remove_first: mk | remove_first: ' ' | strip -%}
        {%- else -%}
          {%- assign mk = first -%}
          {%- assign md = trimmed | remove_first: first | remove_first: ' ' | strip -%}
        {%- endif -%}
        {%- if mk == make and md != blank -%}
          {%- unless first_model -%},{%- endunless -%}
          {"m":{{ md | json }},"h":"","u":""}
          {%- assign first_model = false -%}
        {%- endif -%}
      {%- endfor -%}
      ]
    {%- endfor -%}
    }
  {%- else -%}
    {}
  {%- endif -%}
{%- else -%}
  [
  {%- if has_fitments -%}
    {%- assign first_row = true -%}
    {%- for fitment in fitment_refs -%}
      {%- assign make_mo = fitment.make.value -%}
      {%- assign mk_raw = make_mo.name.value | default: make_mo.display_name.value | default: make_mo.name | default: '' -%}
      {%- assign mk = mk_raw -%}
      {%- if mk == 'CAT' or mk == 'cat' -%}{%- assign mk = 'Cat' -%}{%- endif -%}
      {%- assign model_mo = fitment.model.value -%}
      {%- assign md_full = model_mo.display_name.value | default: model_mo.display_name | default: model_mo.system.handle -%}
      {%- assign md = md_full | remove_first: mk | remove_first: ' ' | strip -%}
      {%- if md == blank -%}{%- assign md = md_full -%}{%- endif -%}
      {%- assign mu = model_mo.system.url | default: '' -%}
      {%- if mk != blank and md != blank -%}
        {%- unless first_row -%},{%- endunless -%}
        {"k":{{ mk | json }},"m":{{ md | json }},"u":{{ mu | json }}}
        {%- assign first_row = false -%}
      {%- endif -%}
    {%- endfor -%}
  {%- elsif has_legacy_models -%}
    {%- assign first_row = true -%}
    {%- for model_mo in legacy_model_refs -%}
      {%- assign make_mo = model_mo.make.value -%}
      {%- assign mk_raw = make_mo.name.value | default: make_mo.display_name.value | default: make_mo.name | default: '' -%}
      {%- assign mk = mk_raw -%}
      {%- if mk == 'CAT' or mk == 'cat' -%}{%- assign mk = 'Cat' -%}{%- endif -%}
      {%- assign md_full = model_mo.display_name.value | default: model_mo.display_name | default: model_mo.system.handle -%}
      {%- assign md = md_full | remove_first: mk | remove_first: ' ' | strip -%}
      {%- if md == blank -%}{%- assign md = md_full -%}{%- endif -%}
      {%- assign mu = model_mo.system.url | default: '' -%}
      {%- if mk != blank and md != blank -%}
        {%- unless first_row -%},{%- endunless -%}
        {"k":{{ mk | json }},"m":{{ md | json }},"u":{{ mu | json }}}
        {%- assign first_row = false -%}
      {%- endif -%}
    {%- endfor -%}
  {%- elsif compatible_raw != blank -%}
    {%- assign machines = compatible_raw | newline_to_br | split: '<br />' -%}
    {%- assign multi_word_makes = 'John Deere||New Holland||Ditch Witch||Wacker Neuson' -%}
    {%- assign first_row = true -%}
    {%- for machine in machines -%}
      {%- assign trimmed = machine | strip | strip_html -%}
      {%- if trimmed == blank -%}{%- continue -%}{%- endif -%}
      {%- assign words = trimmed | split: ' ' -%}
      {%- if words.size < 2 -%}{%- continue -%}{%- endif -%}
      {%- assign first = words[0] -%}
      {%- assign second = words[1] -%}
      {%- if multi_word_makes contains first -%}
        {%- assign mk = first | append: ' ' | append: second -%}
        {%- assign md = trimmed | remove_first: mk | remove_first: ' ' | strip -%}
      {%- else -%}
        {%- assign mk = first -%}
        {%- assign md = trimmed | remove_first: first | remove_first: ' ' | strip -%}
      {%- endif -%}
      {%- if mk != blank and md != blank -%}
        {%- unless first_row -%},{%- endunless -%}
        {"k":{{ mk | json }},"m":{{ md | json }},"u":""}
        {%- assign first_row = false -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  ]
{%- endif -%}
