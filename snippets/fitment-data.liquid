{%- comment -%}
  fitment-data.liquid — governed Shopify fitment source for PDP widgets.
  Reads custom.fitments (fitment metaobject references projected from the certified graph).
  Legacy free-text compatible_with is intentionally not used as a fallback.

  Params:
    - product (required)
    - output: 'rows' (default) | 'grouped'
{%- endcomment -%}
{%- liquid
  assign fitment_refs = product.metafields.custom.fitments.value
  assign has_fitments = false
  if fitment_refs != blank and fitment_refs.size > 0
    assign has_fitments = true
  endif
  assign fit_output = output | default: 'rows'
-%}
{%- if fit_output == 'grouped' -%}
  {%- comment -%}
    Prefer the projected render-ready blob when present. It is generated from the same
    governed fitment source. Fall through to live metaobject references if absent.
  {%- endcomment -%}
  {%- assign display_blob = product.metafields.custom.fitments_display.value -%}
  {%- if display_blob != blank and display_blob != empty and has_fitments -%}
    {{ display_blob | json }}
  {%- elsif has_fitments -%}
    {%- assign make_list = '' -%}
    {%- for fitment in fitment_refs -%}
      {%- assign make_mo = fitment.make.value -%}
      {%- assign make_name = make_mo.name.value | default: make_mo.display_name.value | default: make_mo.name | default: '' -%}
      {%- if make_name != blank -%}
        {%- unless make_list contains make_name -%}
          {%- if make_list != '' -%}{%- assign make_list = make_list | append: '||' -%}{%- endif -%}
          {%- assign make_list = make_list | append: make_name -%}
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
    {%- assign makes = make_list | split: '||' -%}
    {
    {%- for make in makes -%}
      {%- unless forloop.first -%},{%- endunless -%}
      {{ make | json }}:[
      {%- assign first_model = true -%}
      {%- for fitment in fitment_refs -%}
        {%- assign fmake_mo = fitment.make.value -%}
        {%- assign fmake = fmake_mo.name.value | default: fmake_mo.display_name.value | default: fmake_mo.name | default: '' -%}
        {%- if fmake == make -%}
          {%- assign model_mo = fitment.model.value -%}
          {%- assign model_display = model_mo.display_name.value | default: model_mo.display_name | default: model_mo.system.handle -%}
          {%- assign model_label = model_display -%}
          {%- assign mk_prefix = model_display | slice: 0, make.size -%}
          {%- if mk_prefix == make -%}
            {%- assign model_label = model_display | slice: make.size, model_display.size | strip -%}
          {%- endif -%}
          {%- if model_label == blank -%}{%- assign model_label = model_display -%}{%- endif -%}
          {%- assign model_url = model_mo.system.url | default: '' -%}
          {%- assign model_handle = fitment.handle | default: model_mo.system.handle | default: '' -%}
          {%- unless first_model -%},{%- endunless -%}
          {"m":{{ model_label | json }},"h":{{ model_handle | json }},"u":{{ model_url | json }}}
          {%- assign first_model = false -%}
        {%- endif -%}
      {%- endfor -%}
      ]
    {%- endfor -%}
    }
  {%- else -%}
    {}
  {%- endif -%}
{%- else -%}
  [
  {%- if has_fitments -%}
    {%- assign first_row = true -%}
    {%- for fitment in fitment_refs -%}
      {%- assign make_mo = fitment.make.value -%}
      {%- assign mk_raw = make_mo.name.value | default: make_mo.display_name.value | default: make_mo.name | default: '' -%}
      {%- assign mk = mk_raw -%}
      {%- if mk == 'CAT' or mk == 'cat' -%}{%- assign mk = 'Cat' -%}{%- endif -%}
      {%- assign model_mo = fitment.model.value -%}
      {%- assign md_full = model_mo.display_name.value | default: model_mo.display_name | default: model_mo.system.handle -%}
      {%- assign md = md_full -%}
      {%- assign mk_prefix = md_full | slice: 0, mk.size -%}
      {%- if mk_prefix == mk -%}
        {%- assign md = md_full | slice: mk.size, md_full.size | strip -%}
      {%- endif -%}
      {%- if md == blank -%}{%- assign md = md_full -%}{%- endif -%}
      {%- assign mu = model_mo.system.url | default: '' -%}
      {%- if mk != blank and md != blank -%}
        {%- unless first_row -%},{%- endunless -%}
        {"k":{{ mk | json }},"m":{{ md | json }},"u":{{ mu | json }}}
        {%- assign first_row = false -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  ]
{%- endif -%}
