{%- comment -%}
  Dynamic Product JSON-LD engine.
  Source of truth is Shopify product data + synced Supabase metafields.
  Params: product
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign fitment_refs = product.metafields.custom.fitments.value
  assign specs = product.metafields.custom.specs.value
  assign fallback = product.metafields.custom.tracktech_data_fallback.value
  assign fallback_specs = fallback.specs
  assign hi_ts = product.metafields.custom.track_size.value | default: product.metafields.custom.track_size | default: specs.track_size | default: fallback_specs.track_size
  assign hi_width_mm = product.metafields.custom.width_mm.value | default: specs.width_mm | default: fallback_specs.width_mm
  assign hi_width_in = product.metafields.custom.width_in.value | default: specs.width_in | default: fallback_specs.width_in
  assign hi_pitch_mm = product.metafields.custom.pitch_mm.value | default: specs.pitch_mm | default: fallback_specs.pitch_mm
  assign hi_pitch_type = product.metafields.custom.pitch_type.value | default: specs.pitch_type | default: fallback_specs.pitch_type
  assign hi_links = product.metafields.custom.links.value | default: specs.links | default: fallback_specs.links
  assign hi_guide = product.metafields.custom.guide.value | default: specs.guide_type | default: fallback_specs.guide_type
  assign hi_tread = product.metafields.custom.tread_pattern.value | default: specs.tread_pattern | default: fallback_specs.tread_pattern
  assign hi_tread_down = hi_tread | downcase
  assign hi_vocation = ''
  assign hi_benefit = ''
  if hi_tread_down contains 'c-block' or hi_tread_down contains 'c block' or hi_tread_down contains 'c pattern'
    assign hi_vocation = 'Demolition, paving, concrete removal, jagged rock, asphalt, and sharp gravel'
    assign hi_benefit = 'C-Block tread stabilizes hard-surface work, reduces vibration on pavement, and helps resist chunking from concrete and sharp aggregate.'
  elsif hi_tread_down contains 'z-max' or hi_tread_down contains 'z max' or hi_tread_down contains 'zig'
    assign hi_vocation = 'Deep mud, swamp, loose clay, forestry, excavation, and high-precipitation jobsites'
    assign hi_benefit = 'Z-Max tread clears mud aggressively and maintains forward bite in wet soil, swamp, and loose clay conditions.'
  elsif hi_tread_down contains 'multi-bar' or hi_tread_down contains 'multi bar' or hi_tread_down contains 'snow'
    assign hi_vocation = 'Snow removal, ice, slush, winter agriculture, and sub-zero operations'
    assign hi_benefit = 'Multi-Bar tread adds linear biting edges for snow, ice, and slush traction where standard block patterns can skate.'
  elsif hi_tread_down contains 'block' or hi_tread_down contains 'stagger'
    assign hi_vocation = 'Landscaping, turf, finished lawns, golf course maintenance, dry soil, and moderate ground conditions'
    assign hi_benefit = 'Staggered block tread spreads ground pressure to reduce turf disturbance while keeping enough bite for mixed landscaping work.'
  elsif hi_tread_down contains 'all-terrain' or hi_tread_down contains 'all terrain'
    assign hi_vocation = 'Excavation, site prep, dirt, clay, mixed subdivisions, and general construction'
    assign hi_benefit = 'All-Terrain tread balances ride quality, self-cleaning, and traction across everyday dirt, clay, gravel, and mixed construction surfaces.'
  endif
  assign hi_warranty_months = product.metafields.custom.warranty_months.value | default: specs.warranty_months | default: 24
  assign hi_description = fallback.text | default: product.description | strip_html | truncate: 250
  assign hi_price_valid_until = 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d'
  assign hi_category = 'Vehicles & Parts > Vehicle Parts & Accessories > Heavy Machinery Parts'
-%}
{%- if template.name == 'product' and variant != blank -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "@id": {{ product.url | prepend: shop.url | append: '#product' | json }},
  "name": {{ product.title | json }},
  "url": {{ product.url | prepend: shop.url | json }},
  "image": [
    {%- for image in product.images limit: 12 -%}
      {{ image | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "description": {{ hi_description | json }},
  "brand": { "@type": "Brand", "name": "Heavy Iron Supply Co." },
  "sku": {{ variant.sku | default: product.id | json }},
  "mpn": {{ variant.sku | default: product.id | json }},
  "category": {{ hi_category | json }},
  "offers": {
    "@type": "Offer",
    "url": {{ product.url | prepend: shop.url | json }},
    "priceCurrency": {{ cart.currency.iso_code | default: shop.currency | json }},
    "price": {{ variant.price | divided_by: 100.0 | json }},
    "priceValidUntil": {{ hi_price_valid_until | json }},
    "itemCondition": "https://schema.org/NewCondition",
    "availability": {% if variant.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingRate": {
        "@type": "MonetaryAmount",
        "value": "0.00",
        "currency": {{ cart.currency.iso_code | default: shop.currency | json }}
      },
      "shippingDestination": {
        "@type": "DefinedRegion",
        "addressCountry": "US"
      },
      "deliveryTime": {
        "@type": "ShippingDeliveryTime",
        "handlingTime": {
          "@type": "QuantitativeValue",
          "minValue": 0,
          "maxValue": 1,
          "unitCode": "DAY"
        },
        "transitTime": {
          "@type": "QuantitativeValue",
          "minValue": 1,
          "maxValue": 3,
          "unitCode": "DAY"
        }
      }
    }
  },
  "additionalProperty": [
    {%- assign hi_prop_i = 0 -%}
    {%- if hi_ts != blank -%}
      {%- if hi_prop_i > 0 -%},{%- endif -%}
      { "@type": "PropertyValue", "name": "Track Size", "value": {{ hi_ts | json }} }
      {%- assign hi_prop_i = hi_prop_i | plus: 1 -%}
    {%- endif -%}
    {%- if hi_width_mm != blank -%}
      {%- if hi_prop_i > 0 -%},{%- endif -%}
      { "@type": "PropertyValue", "name": "Track Width", "value": {{ hi_width_mm | append: 'mm' | json }}, "unitCode": "MMT" }
      {%- assign hi_prop_i = hi_prop_i | plus: 1 -%}
    {%- endif -%}
    {%- if hi_width_in != blank -%}
      {%- if hi_prop_i > 0 -%},{%- endif -%}
      { "@type": "PropertyValue", "name": "Track Width (Inches)", "value": {{ hi_width_in | json }}, "unitCode": "INH" }
      {%- assign hi_prop_i = hi_prop_i | plus: 1 -%}
    {%- endif -%}
    {%- if hi_pitch_mm != blank -%}
      {%- if hi_prop_i > 0 -%},{%- endif -%}
      { "@type": "PropertyValue", "name": "Pitch", "value": {{ hi_pitch_mm | append: 'mm' | json }}, "unitCode": "MMT" }
      {%- assign hi_prop_i = hi_prop_i | plus: 1 -%}
    {%- endif -%}
    {%- if hi_pitch_type != blank -%}
      {%- if hi_prop_i > 0 -%},{%- endif -%}
      { "@type": "PropertyValue", "name": "Pitch Type", "value": {{ hi_pitch_type | json }} }
      {%- assign hi_prop_i = hi_prop_i | plus: 1 -%}
    {%- endif -%}
    {%- if hi_links != blank -%}
      {%- if hi_prop_i > 0 -%},{%- endif -%}
      { "@type": "PropertyValue", "name": "Link Count", "value": {{ hi_links | json }} }
      {%- assign hi_prop_i = hi_prop_i | plus: 1 -%}
    {%- endif -%}
    {%- if hi_guide != blank -%}
      {%- if hi_prop_i > 0 -%},{%- endif -%}
      { "@type": "PropertyValue", "name": "Guide Type", "value": {{ hi_guide | json }} }
      {%- assign hi_prop_i = hi_prop_i | plus: 1 -%}
    {%- endif -%}
    {%- if hi_tread != blank -%}
      {%- if hi_prop_i > 0 -%},{%- endif -%}
      { "@type": "PropertyValue", "name": "Tread Pattern", "value": {{ hi_tread | json }} }
      {%- assign hi_prop_i = hi_prop_i | plus: 1 -%}
    {%- endif -%}
    {%- if hi_vocation != blank -%}
      {%- if hi_prop_i > 0 -%},{%- endif -%}
      { "@type": "PropertyValue", "name": "Primary Vocation Match", "value": {{ hi_vocation | json }} }
      {%- assign hi_prop_i = hi_prop_i | plus: 1 -%}
    {%- endif -%}
    {%- if hi_benefit != blank -%}
      {%- if hi_prop_i > 0 -%},{%- endif -%}
      { "@type": "PropertyValue", "name": "Engineering Benefit", "value": {{ hi_benefit | json }} }
      {%- assign hi_prop_i = hi_prop_i | plus: 1 -%}
    {%- endif -%}
    {%- if hi_warranty_months != blank -%}
      {%- if hi_prop_i > 0 -%},{%- endif -%}
      { "@type": "PropertyValue", "name": "Warranty", "value": {{ hi_warranty_months | append: '-Month / 1,000-Hour' | json }} }
      {%- assign hi_prop_i = hi_prop_i | plus: 1 -%}
    {%- endif -%}
    {%- if hi_ts != blank -%}
      {%- if hi_prop_i > 0 -%},{%- endif -%}
      { "@type": "PropertyValue", "name": "Requires Sprocket Modification", "value": "False" },
      { "@type": "PropertyValue", "name": "Susceptible to Cable Crimp Snapping", "value": "False" },
      { "@type": "PropertyValue", "name": "Utilizes Recycled Rubber Fillers", "value": "False" },
      { "@type": "PropertyValue", "name": "Guaranteed Drop-In Fit", "value": "True" }
      {%- assign hi_prop_i = hi_prop_i | plus: 4 -%}
    {%- endif -%}
    {%- if fitment_refs != blank -%}
      {%- if hi_prop_i > 0 -%},{%- endif -%}
      {
        "@type": "PropertyValue",
        "name": "Compatible Models",
        "value": [
          {%- assign hi_ci = 0 -%}
          {%- for fitment in fitment_refs limit: 25 -%}
            {%- assign model_mo = fitment.model.value -%}
            {%- assign make_mo = fitment.make.value -%}
            {%- assign mk = make_mo.name.value | default: make_mo.display_name.value | default: '' -%}
            {%- assign md = model_mo.display_name.value | default: model_mo.system.handle | default: '' -%}
            {%- if mk != blank and md != blank -%}
              {%- if hi_ci > 0 -%},{%- endif -%}
              {{ mk | append: ' ' | append: md | json }}
              {%- assign hi_ci = hi_ci | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      }
    {%- endif -%}
  ]
  {%- if fitment_refs != blank -%},
  "isAccessoryOrSparePartFor": [
    {%- assign hi_fi = 0 -%}
    {%- for fitment in fitment_refs limit: 25 -%}
      {%- assign model_mo = fitment.model.value -%}
      {%- assign make_mo = fitment.make.value -%}
      {%- assign mk = make_mo.name.value | default: make_mo.display_name.value | default: '' -%}
      {%- assign md = model_mo.display_name.value | default: model_mo.system.handle | default: '' -%}
      {%- if mk != blank and md != blank -%}
        {%- if hi_fi > 0 -%},{%- endif -%}
        { "@type": "Product", "name": {{ mk | append: ' ' | append: md | json }} }
        {%- assign hi_fi = hi_fi | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  ]
  {%- endif -%}
}
</script>
{%- endif -%}
