{%- comment -%}
  Enhanced Product JSON-LD: Shopify base + fitment + shipping on Offer.
  Params: product
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign fitment_refs = product.metafields.custom.fitments.value
  assign hi_ts = product.metafields.custom.track_size.value | default: product.metafields.custom.track_size
  assign hi_width_mm = product.metafields.custom.width_mm.value
  assign hi_width_in = product.metafields.custom.width_in.value
  assign hi_pitch_mm = product.metafields.custom.pitch_mm.value
  assign hi_pitch_type = product.metafields.custom.pitch_type.value
  assign hi_links = product.metafields.custom.links.value
  assign hi_guide = product.metafields.custom.guide.value
  assign hi_warranty_months = product.metafields.custom.warranty_months.value
  assign hi_category = product.type | default: 'Heavy Equipment Parts'
  if hi_ts != blank
    assign hi_category = 'Rubber Tracks'
  endif
  assign hi_has_specs = false
  if hi_ts != blank or hi_width_mm != blank or hi_width_in != blank or hi_pitch_mm != blank or hi_pitch_type != blank or hi_links != blank or hi_guide != blank or hi_warranty_months != blank
    assign hi_has_specs = true
  endif
-%}
<script type="application/ld+json">
  {{ product | structured_data }}
</script>
{%- if hi_has_specs -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": {{ product.url | prepend: shop.url | append: '#specifications' | json }},
  "name": {{ product.title | json }},
  "url": {{ product.url | prepend: shop.url | json }},
  "category": {{ hi_category | json }},
  "additionalProperty": [
    {%- assign hi_prop_i = 0 -%}
    {%- if hi_ts != blank -%}
      {%- if hi_prop_i > 0 -%},{%- endif -%}
      { "@type": "PropertyValue", "name": "Track Size", "value": {{ hi_ts | json }} }
      {%- assign hi_prop_i = hi_prop_i | plus: 1 -%}
    {%- endif -%}
    {%- if hi_width_mm != blank -%}
      {%- if hi_prop_i > 0 -%},{%- endif -%}
      { "@type": "PropertyValue", "name": "Width", "value": {{ hi_width_mm | json }}, "unitCode": "MMT" }
      {%- assign hi_prop_i = hi_prop_i | plus: 1 -%}
    {%- endif -%}
    {%- if hi_width_in != blank -%}
      {%- if hi_prop_i > 0 -%},{%- endif -%}
      { "@type": "PropertyValue", "name": "Width", "value": {{ hi_width_in | json }}, "unitText": "in" }
      {%- assign hi_prop_i = hi_prop_i | plus: 1 -%}
    {%- endif -%}
    {%- if hi_pitch_mm != blank -%}
      {%- if hi_prop_i > 0 -%},{%- endif -%}
      { "@type": "PropertyValue", "name": "Pitch", "value": {{ hi_pitch_mm | json }}, "unitCode": "MMT" }
      {%- assign hi_prop_i = hi_prop_i | plus: 1 -%}
    {%- endif -%}
    {%- if hi_pitch_type != blank -%}
      {%- if hi_prop_i > 0 -%},{%- endif -%}
      { "@type": "PropertyValue", "name": "Pitch Type", "value": {{ hi_pitch_type | json }} }
      {%- assign hi_prop_i = hi_prop_i | plus: 1 -%}
    {%- endif -%}
    {%- if hi_links != blank -%}
      {%- if hi_prop_i > 0 -%},{%- endif -%}
      { "@type": "PropertyValue", "name": "Links", "value": {{ hi_links | json }} }
      {%- assign hi_prop_i = hi_prop_i | plus: 1 -%}
    {%- endif -%}
    {%- if hi_guide != blank -%}
      {%- if hi_prop_i > 0 -%},{%- endif -%}
      { "@type": "PropertyValue", "name": "Guide Type", "value": {{ hi_guide | json }} }
      {%- assign hi_prop_i = hi_prop_i | plus: 1 -%}
    {%- endif -%}
    {%- if hi_warranty_months != blank -%}
      {%- if hi_prop_i > 0 -%},{%- endif -%}
      { "@type": "PropertyValue", "name": "Warranty", "value": {{ hi_warranty_months | append: ' months' | json }} }
      {%- assign hi_prop_i = hi_prop_i | plus: 1 -%}
    {%- endif -%}
    {%- if hi_ts != blank -%}
      {%- if hi_prop_i > 0 -%},{%- endif -%}
      { "@type": "PropertyValue", "name": "Requires Sprocket Modification", "value": "False" },
      { "@type": "PropertyValue", "name": "Susceptible to Cable Crimp Snapping", "value": "False" },
      { "@type": "PropertyValue", "name": "Utilizes Recycled Rubber Fillers", "value": "False" },
      { "@type": "PropertyValue", "name": "Guaranteed Drop-In Fit", "value": "True" }
      {%- if hi_pitch_type != blank or hi_guide != blank -%},
        { "@type": "PropertyValue", "name": "Dedicated Pitch Alignment", "value": {{ hi_pitch_type | default: hi_guide | append: ' pitch' | json }} }
      {%- endif -%}
    {%- endif -%}
  ]
}
</script>
{%- endif -%}
{%- if fitment_refs != blank -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": {{ product.url | prepend: shop.url | append: '#fitment' | json }},
  "name": {{ product.title | json }},
  "url": {{ product.url | prepend: shop.url | json }},
  "category": {{ hi_category | json }},
  "brand": { "@type": "Brand", "name": "Heavy Iron Supply Co." },
  "isAccessoryOrSparePartFor": [
    {%- assign hi_fi = 0 -%}
    {%- for fitment in fitment_refs limit: 15 -%}
      {%- assign model_mo = fitment.model.value -%}
      {%- assign make_mo = fitment.make.value -%}
      {%- assign mk = make_mo.name.value | default: make_mo.display_name.value | default: '' -%}
      {%- assign md = model_mo.display_name.value | default: model_mo.system.handle | default: '' -%}
      {%- if mk != blank and md != blank -%}
        {%- if hi_fi > 0 -%},{%- endif -%}
        { "@type": "Product", "name": {{ mk | append: ' ' | append: md | json }} }
        {%- assign hi_fi = hi_fi | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
{%- if hi_ts != blank and variant.price > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": {{ product.url | prepend: shop.url | append: '#free-ltl-offer' | json }},
  "name": {{ product.title | json }},
  "url": {{ product.url | prepend: shop.url | json }},
  "sku": {{ variant.sku | default: product.selected_or_first_available_variant.sku | json }},
  "brand": { "@type": "Brand", "name": "Heavy Iron Supply Co." },
  "category": "Vehicles & Parts > Vehicle Parts & Accessories > Heavy Machinery Parts",
  "offers": {
    "@type": "Offer",
    "url": {{ product.url | prepend: shop.url | json }},
    "priceCurrency": {{ shop.currency | json }},
    "price": {{ variant.price | divided_by: 100.0 | json }},
    "priceValidUntil": "2027-12-31",
    "itemCondition": "https://schema.org/NewCondition",
    "availability": {% if variant.available %}"https://schema.org/InStock"{% else %}"https://schema.org/PreOrder"{% endif %},
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingRate": { "@type": "MonetaryAmount", "value": "0.00", "currency": {{ shop.currency | json }} },
      "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "US" },
      "deliveryTime": {
        "@type": "ShippingDeliveryTime",
        "handlingTime": { "@type": "QuantitativeValue", "minValue": 0, "maxValue": 1, "unitCode": "DAY" },
        "transitTime": { "@type": "QuantitativeValue", "minValue": 2, "maxValue": 5, "unitCode": "DAY" }
      }
    }
  }
}
</script>
{%- endif -%}
