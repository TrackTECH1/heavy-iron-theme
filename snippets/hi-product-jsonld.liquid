{%- comment -%}
  Enhanced Product JSON-LD: Shopify base + fitment + shipping on Offer.
  Params: product
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign fitment_refs = product.metafields.custom.fitments.value
  assign hi_ts = product.metafields.custom.track_size.value | default: product.metafields.custom.track_size
  assign hi_category = product.type | default: 'Heavy Equipment Parts'
  if hi_ts != blank
    assign hi_category = 'Rubber Tracks'
  endif
-%}
<script type="application/ld+json">
  {{ product | structured_data }}
</script>
{%- if fitment_refs != blank -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": {{ product.url | prepend: shop.url | append: '#fitment' | json }},
  "name": {{ product.title | json }},
  "url": {{ product.url | prepend: shop.url | json }},
  "category": {{ hi_category | json }},
  "brand": { "@type": "Brand", "name": "Heavy Iron Supply Co." },
  "isAccessoryOrSparePartFor": [
    {%- assign hi_fi = 0 -%}
    {%- for fitment in fitment_refs limit: 15 -%}
      {%- assign model_mo = fitment.model.value -%}
      {%- assign make_mo = fitment.make.value -%}
      {%- assign mk = make_mo.name.value | default: make_mo.display_name.value | default: '' -%}
      {%- assign md = model_mo.display_name.value | default: model_mo.system.handle | default: '' -%}
      {%- if mk != blank and md != blank -%}
        {%- if hi_fi > 0 -%},{%- endif -%}
        { "@type": "Product", "name": {{ mk | append: ' ' | append: md | json }} }
        {%- assign hi_fi = hi_fi | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
{%- if variant.available and hi_ts != blank -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "OfferShippingDetails",
  "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "US" },
  "shippingRate": { "@type": "MonetaryAmount", "value": "0", "currency": {{ shop.currency | json }} },
  "deliveryTime": {
    "@type": "ShippingDeliveryTime",
    "handlingTime": { "@type": "QuantitativeValue", "minValue": 0, "maxValue": 1, "unitCode": "DAY" },
    "transitTime": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": 5, "unitCode": "DAY" }
  }
}
</script>
{%- endif -%}
