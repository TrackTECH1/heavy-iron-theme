{%- comment -%}
  Guaranteed Fit Widget
  Make/Model dropdowns → animated "Guaranteed Fit" or "Not Compatible" banner.
  Data source: fitment-data.liquid → custom.fitments (+ compatible_with fallback).
{%- endcomment -%}

{%- assign fem_refs = product.metafields.custom.fits_equipment_models.value -%}
{%- assign fitment_refs = product.metafields.custom.fitments.value -%}
{%- assign compatible_raw = product.metafields.custom.compatible_with.value -%}
{%- assign has_fem = false -%}
{%- if fem_refs != blank and fem_refs.size > 0 -%}
  {%- assign has_fem = true -%}
{%- endif -%}
{%- assign has_fitments = false -%}
{%- if fitment_refs != blank and fitment_refs.size > 0 -%}
  {%- assign has_fitments = true -%}
{%- endif -%}
{%- assign has_compat_text = false -%}
{%- if compatible_raw != blank -%}
  {%- assign has_compat_text = true -%}
{%- endif -%}

{%- if has_fem == false and has_fitments == false and has_compat_text == false -%}
{%- else -%}

<div class="gfit" id="guaranteed-fit-{{ section.id }}">
  {%- comment -%}
    Fitment JSON lives in a script tag, not a single-quoted attribute: the `json`
    filter does not escape apostrophes, so a make/model label with an apostrophe
    would otherwise terminate the attribute early and break JSON.parse.
  {%- endcomment -%}
  <script type="application/json" data-gfit-data>{%- render 'fitment-data', product: product, output: 'grouped' -%}</script>

  <div class="gfit__selectors">
    <div class="gfit__row">
      <div class="gfit__field">
        <label class="gfit__label" for="gfit-make-{{ section.id }}">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
          Your Machine Make
        </label>
        <div class="gfit__select-wrap">
          <select id="gfit-make-{{ section.id }}" class="gfit__select gfit__select--make" aria-label="Select machine make">
            <option value="">— Select Make —</option>
          </select>
          <svg class="gfit__select-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
        </div>
      </div>

      <div class="gfit__field gfit__field--model" aria-hidden="true">
        <label class="gfit__label" for="gfit-model-{{ section.id }}">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5M2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          Your Model
        </label>
        <div class="gfit__select-wrap">
          <select id="gfit-model-{{ section.id }}" class="gfit__select gfit__select--model" disabled aria-label="Select machine model">
            <option value="">— Select Model —</option>
          </select>
          <svg class="gfit__select-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
        </div>
      </div>
    </div>
  </div>

  <div class="gfit__result" aria-live="polite">
    <div class="gfit__confirmed" hidden>
      <div class="gfit__confirmed-inner">
        <div class="gfit__check">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path class="gfit__check-path" d="M4 12l6 6L20 6"/>
          </svg>
        </div>
        <div class="gfit__confirmed-text">
          <p class="gfit__confirmed-title">Guaranteed Fit</p>
          <p class="gfit__confirmed-sub">Confirmed for your <strong class="gfit__machine-name"></strong></p>
        </div>
        <a class="gfit__model-link" href="#" target="_blank">
          View machine page
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
        </a>
      </div>
    </div>

    <div class="gfit__incompatible" hidden>
      <div class="gfit__incompatible-inner">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6M9 9l6 6"/></svg>
        <div>
          <p class="gfit__incompatible-title">Not Compatible</p>
          <p class="gfit__incompatible-sub">This track does not fit your <strong class="gfit__nc-machine"></strong>. <a class="gfit__find-link" href="/search?q=rubber+track&type=product">Find the right track →</a></p>
        </div>
      </div>
    </div>
  </div>

</div>

<style>
.gfit { margin-bottom: 1.6rem; }
.gfit__selectors { background: rgba(var(--color-foreground), 0.03); border: 1px solid rgba(var(--color-foreground), 0.08); border-radius: 8px; padding: 1.4rem; margin-bottom: 1rem; }
.gfit__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
@media screen and (max-width: 749px) { .gfit__row { grid-template-columns: 1fr; gap: 0.8rem; } }
.gfit__label { display: flex; align-items: center; gap: 0.5rem; font-size: 1.1rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: rgba(var(--color-foreground), 0.5); margin-bottom: 0.6rem; }
.gfit__label svg { stroke: rgba(var(--color-foreground), 0.4); }
.gfit__select-wrap { position: relative; }
.gfit__select { width: 100%; padding: 0.9rem 3.2rem 0.9rem 1.2rem; font-size: 1.3rem; font-weight: 600; color: rgb(var(--color-foreground)); background: rgb(var(--color-background)); border: 1.5px solid rgba(var(--color-foreground), 0.15); border-radius: 6px; appearance: none; cursor: pointer; transition: border-color 0.2s, box-shadow 0.2s; outline: none; }
.gfit__select:focus { border-color: #FFB607; box-shadow: 0 0 0 3px rgba(255,182,7,0.15); }
.gfit__select:disabled { opacity: 0.4; cursor: not-allowed; }
.gfit__select-caret { position: absolute; right: 1.2rem; top: 50%; transform: translateY(-50%); pointer-events: none; stroke: rgba(var(--color-foreground), 0.4); }
.gfit__field--model { transition: opacity 0.2s; }
.gfit__field--model[aria-hidden="true"] { opacity: 0.4; }
.gfit__field--model[aria-hidden="false"] { opacity: 1; }
.gfit__confirmed { border-radius: 8px; overflow: hidden; animation: gfitSlideIn 0.35s cubic-bezier(0.34,1.56,0.64,1) forwards; }
@keyframes gfitSlideIn { from { opacity:0; transform: translateY(-8px) scale(0.97); } to { opacity:1; transform: translateY(0) scale(1); } }
@keyframes gfitCheckDraw { from { stroke-dashoffset: 30; } to { stroke-dashoffset: 0; } }
.gfit__confirmed-inner { display: flex; align-items: center; gap: 1.2rem; background: linear-gradient(135deg,#1a1a1a 0%,#2a2a2a 100%); border: 1.5px solid rgba(255,182,7,0.3); padding: 1.4rem 1.6rem; border-radius: 8px; }
.gfit__check { flex-shrink: 0; width: 36px; height: 36px; background: #FFB607; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.gfit__check svg { width: 20px; height: 20px; stroke: #1a1a1a; stroke-width: 3; }
.gfit__check-path { stroke-dasharray: 30; stroke-dashoffset: 30; animation: gfitCheckDraw 0.4s 0.2s ease forwards; }
.gfit__confirmed-text { flex: 1; min-width: 0; }
.gfit__confirmed-title { font-size: 1.3rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: #FFB607; margin: 0 0 0.2rem; line-height: 1; }
.gfit__confirmed-sub { font-size: 1.2rem; color: rgba(255,255,255,0.7); margin: 0; line-height: 1.4; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.gfit__confirmed-sub strong { color: #fff; font-weight: 700; }
.gfit__model-link { flex-shrink: 0; display: inline-flex; align-items: center; gap: 0.4rem; font-size: 1.1rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: rgba(255,255,255,0.4); text-decoration: none; white-space: nowrap; transition: color 0.15s; }
.gfit__model-link:hover { color: #FFB607; }
@media screen and (max-width: 749px) { .gfit__model-link { display: none; } }
.gfit__incompatible { animation: gfitSlideIn 0.25s ease forwards; }
.gfit__incompatible-inner { display: flex; align-items: flex-start; gap: 1rem; background: rgba(239,68,68,0.06); border: 1.5px solid rgba(239,68,68,0.2); border-radius: 8px; padding: 1.2rem 1.4rem; color: rgb(var(--color-foreground)); }
.gfit__incompatible-inner svg { stroke: rgb(239,68,68); flex-shrink: 0; margin-top: 0.1rem; }
.gfit__incompatible-title { font-size: 1.25rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: rgb(239,68,68); margin: 0 0 0.2rem; }
.gfit__incompatible-sub { font-size: 1.2rem; margin: 0; color: rgba(var(--color-foreground),0.7); line-height: 1.4; }
.gfit__find-link { color: rgb(var(--color-foreground)); font-weight: 700; text-decoration: underline; }
</style>

<script>
(function() {
  const widget = document.getElementById('guaranteed-fit-{{ section.id }}');
  if (!widget) return;

  const dataEl = widget.querySelector('[data-gfit-data]');
  let fitmentData = {};
  try { fitmentData = JSON.parse((dataEl && dataEl.textContent) || '{}'); } catch (e) { fitmentData = {}; }
  const makeSelect   = widget.querySelector('.gfit__select--make');
  const modelSelect  = widget.querySelector('.gfit__select--model');
  const modelField   = widget.querySelector('.gfit__field--model');
  const confirmed    = widget.querySelector('.gfit__confirmed');
  const incompatible = widget.querySelector('.gfit__incompatible');
  const machineName  = widget.querySelector('.gfit__machine-name');
  const ncMachine    = widget.querySelector('.gfit__nc-machine');
  const modelLink    = widget.querySelector('.gfit__model-link');

  Object.keys(fitmentData).sort(function(a, b) { return a.localeCompare(b); }).forEach(function(make) {
    const opt = document.createElement('option');
    opt.value = make;
    opt.textContent = make;
    makeSelect.appendChild(opt);
  });

  function hideResults() {
    confirmed.hidden = true;
    incompatible.hidden = true;
  }

  function modelPageUrl(make, modelObj) {
    if (modelObj.u) return modelObj.u;
    if (modelObj.h) return '/pages/model/' + modelObj.h;
    return '/pages/model/' + (make + '-' + modelObj.m).toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '-').replace(/-+/g, '-');
  }

  function showConfirmed(make, modelObj) {
    const label = make + ' ' + modelObj.m;
    machineName.textContent = label;
    modelLink.href = modelPageUrl(make, modelObj);
    modelLink.removeAttribute('target');
    confirmed.hidden = false;
    incompatible.hidden = true;
    confirmed.style.animation = 'none';
    confirmed.offsetHeight;
    confirmed.style.animation = '';
  }

  function showIncompatible(make, model) {
    ncMachine.textContent = make + ' ' + model;
    incompatible.hidden = false;
    confirmed.hidden = true;
  }

  makeSelect.addEventListener('change', function() {
    const make = this.value;
    hideResults();
    modelSelect.innerHTML = '<option value="">— Select Model —</option>';
    modelSelect.disabled = true;
    modelField.setAttribute('aria-hidden', 'true');
    if (!make) return;

    const models = fitmentData[make] || [];
    models.forEach(function(modelObj) {
      const opt = document.createElement('option');
      opt.value = modelObj.m;
      opt.textContent = make + ' ' + modelObj.m;
      opt.dataset.url = modelObj.u || '';
      opt.dataset.handle = modelObj.h || '';
      modelSelect.appendChild(opt);
    });

    modelSelect.disabled = false;
    modelField.setAttribute('aria-hidden', 'false');
  });

  modelSelect.addEventListener('change', function() {
    const make  = makeSelect.value;
    const model = this.value;
    hideResults();
    if (!make || !model) return;

    const models  = fitmentData[make] || [];
    const modelObj = models.find(function(m) { return m.m === model; });
    if (modelObj) {
      showConfirmed(make, modelObj);
    } else {
      showIncompatible(make, model);
    }
  });
})();
</script>

{%- endif -%}
