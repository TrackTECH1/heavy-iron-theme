{%- comment -%}
  Heavy Iron — Machine page structured data (JSON-LD).
  Proper @graph: BreadcrumbList + ItemList(of products w/ Offers) + FAQPage.
  Every dynamic value is emitted through the `json` filter so quotes/specials can't break it.
  Params: model (metaobject), model_name, make_name, make_url, track_size
{%- endcomment -%}
{%- liquid
  assign seo_name = model.seo_title.value | default: model_name
  assign seo_desc = model.seo_description.value | default: model_name | append: ' rubber tracks, undercarriage parts & attachments.'
  assign faqs = model.faqs_json.value
  assign track_count = model.track_variants.value.size | default: 0
  if track_count == 0
    assign track_count = model.track_products.value.size | default: 0
  endif
  assign faq_fallback = false
  if faqs == blank
    assign faq_fallback = true
  endif
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ make_name | json }}, "item": {{ shop.url | append: make_url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ model_name | json }}, "item": {{ canonical_url | json }} }
      ]
    },
    {
      "@type": "ItemList",
      "name": {{ seo_name | append: ' — Compatible Products' | json }},
      "description": {{ seo_desc | json }},
      "itemListElement": [
        {%- assign i = 0 -%}
        {%- if model.track_variants.value != blank -%}
          {%- for variant in model.track_variants.value limit: 30 -%}
            {%- assign product = variant.product -%}
            {%- assign i = i | plus: 1 -%}
            {%- if i > 1 -%},{%- endif -%}
            {
              "@type": "ListItem",
              "position": {{ i }},
              "item": {
                "@type": "Product",
                "name": {% if product != blank %}{{ product.title | append: ' - ' | append: variant.title | json }}{% else %}{{ variant.title | default: variant.sku | default: 'Rubber Track' | json }}{% endif %},
                "sku": {{ variant.sku | json }},
                "url": {% if product != blank %}{{ product.url | append: '?variant=' | append: variant.id | prepend: shop.url | json }}{% else %}{{ routes.search_url | append: '?q=' | append: variant.sku | prepend: shop.url | json }}{% endif %},
                "category": "Rubber Tracks",
                {%- if variant.featured_image -%}"image": {{ variant.featured_image | image_url: width: 800 | prepend: 'https:' | json }},{%- elsif product.featured_image -%}"image": {{ product.featured_image | image_url: width: 800 | prepend: 'https:' | json }},{%- endif -%}
                "brand": { "@type": "Brand", "name": "Heavy Iron Supply Co." },
                "isAccessoryOrSparePartFor": { "@type": "Product", "name": {{ model_name | json }} },
                "offers": {
                  "@type": "Offer",
                  "priceCurrency": {{ shop.currency | json }},
                  "price": {{ variant.price | divided_by: 100.0 | json }},
                  "availability": {% if variant.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
                  "url": {% if product != blank %}{{ product.url | append: '?variant=' | append: variant.id | prepend: shop.url | json }}{% else %}{{ routes.search_url | append: '?q=' | append: variant.sku | prepend: shop.url | json }}{% endif %}
                }
              }
            }
          {%- endfor -%}
        {%- else -%}
        {%- for product in model.track_products.value limit: 30 -%}
          {%- assign i = i | plus: 1 -%}
          {%- if i > 1 -%},{%- endif -%}
          {
            "@type": "ListItem",
            "position": {{ i }},
            "item": {
              "@type": "Product",
              "name": {{ product.title | json }},
              "url": {{ product.url | prepend: shop.url | json }},
              "category": "Rubber Tracks",
              {%- if product.featured_image -%}"image": {{ product.featured_image | image_url: width: 800 | prepend: 'https:' | json }},{%- endif -%}
              "brand": { "@type": "Brand", "name": "Heavy Iron Supply Co." },
              "isAccessoryOrSparePartFor": { "@type": "Product", "name": {{ model_name | json }} },
              "offers": {
                "@type": "AggregateOffer",
                "priceCurrency": {{ shop.currency | json }},
                "lowPrice": {{ product.price_min | divided_by: 100.0 | json }},
                "highPrice": {{ product.price_max | divided_by: 100.0 | json }},
                "offerCount": {{ product.variants.size }},
                "availability": {% if product.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
                "url": {{ product.url | prepend: shop.url | json }}
              }
            }
          }
        {%- endfor -%}
        {%- endif -%}
        {%- for product in model.uc_products.value limit: 30 -%}
          {%- assign i = i | plus: 1 -%}
          {%- if i > 1 -%},{%- endif -%}
          {
            "@type": "ListItem",
            "position": {{ i }},
            "item": {
              "@type": "Product",
              "name": {{ product.title | json }},
              "url": {{ product.url | prepend: shop.url | json }},
              "category": "Undercarriage",
              "brand": { "@type": "Brand", "name": "Heavy Iron Supply Co." },
              "isAccessoryOrSparePartFor": { "@type": "Product", "name": {{ model_name | json }} }
              {%- if product.price > 0 -%},
              "offers": { "@type": "Offer", "price": {{ product.price | divided_by: 100.0 | json }}, "priceCurrency": {{ shop.currency | json }}, "availability": "https://schema.org/InStock" }
              {%- endif -%}
            }
          }
        {%- endfor -%}
      ]
    }
    {%- if faqs != blank or faq_fallback -%}
    ,{
      "@type": "FAQPage",
      "mainEntity": [
        {%- if faqs != blank -%}
          {%- for faq in faqs -%}
            {%- unless forloop.first -%},{%- endunless -%}
            {
              "@type": "Question",
              "name": {{ faq.question | json }},
              "acceptedAnswer": { "@type": "Answer", "text": {{ faq.answer | strip_html | json }} }
            }
          {%- endfor -%}
        {%- else -%}
          {
            "@type": "Question",
            "name": {{ 'What size rubber tracks fit the ' | append: make_name | append: ' ' | append: model_name | append: '?' | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {% if track_size != blank %}{{ 'The ' | append: make_name | append: ' ' | append: model_name | append: ' commonly uses track size ' | append: track_size | append: '.' | json }}{% else %}{{ 'Track size varies by configuration. Measure your existing track or call us with your serial number.' | json }}{% endif %} }
          },
          {
            "@type": "Question",
            "name": {{ 'Are Heavy Iron tracks guaranteed to fit my ' | append: model_name | append: '?' | json }},
            "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every rubber track order requires you to confirm make and model at checkout. Wrong-fit claims are covered under our fitment guarantee." }
          },
          {
            "@type": "Question",
            "name": {{ 'How fast do ' | append: model_name | append: ' tracks ship?' | json }},
            "acceptedAnswer": { "@type": "Answer", "text": "Orders placed before 12PM CT ship the same business day. Rubber tracks ship free via LTL freight to the contiguous United States." }
          },
          {
            "@type": "Question",
            "name": {{ 'What tread patterns are available for the ' | append: model_name | append: '?' | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {% if track_count > 0 %}{{ 'We stock ' | append: track_count | append: '+ tread options including C-Block, multi-bar, and directional patterns.' | json }}{% else %}"Common treads include C-Block, multi-bar, and directional patterns."{% endif %} }
          }
        {%- endif -%}
      ]
    }
    {%- endif -%}
  ]
}
</script>
