{%- comment -%}
  Heavy Iron — Machine page structured data (JSON-LD).
  Proper @graph: BreadcrumbList + ItemList(of products w/ Offers) + FAQPage.
  Every dynamic value is emitted through the `json` filter so quotes/specials can't break it.
  Params: model (metaobject), model_name, make_name, make_url, track_size
{%- endcomment -%}
{%- liquid
  assign seo_name = model.seo_title.value | default: model_name
  assign seo_desc = model.seo_description.value | default: model_name | append: ' rubber tracks, undercarriage parts & attachments.'
  assign faqs = model.faqs_json.value
  assign track_count = model.track_variants.value.size | default: 0
  if track_count == 0
    assign track_count = model.track_products.value.size | default: 0
  endif
  assign faq_fallback = false
  if faqs == blank
    assign faq_fallback = true
  endif
  assign machine_schema_name = make_name | append: ' ' | append: model_name | strip
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ make_name | json }}, "item": {{ shop.url | append: make_url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ model_name | json }}, "item": {{ canonical_url | json }} }
      ]
    },
    {
      "@type": "ItemList",
      "name": {{ seo_name | append: ' — Compatible Products' | json }},
      "description": {{ seo_desc | json }},
      "itemListElement": [
        {%- assign i = 0 -%}
        {%- if model.track_variants.value != blank -%}
          {%- for variant in model.track_variants.value limit: 30 -%}
            {%- assign product = variant.product -%}
            {%- if product == blank -%}{%- continue -%}{%- endif -%}
            {%- assign i = i | plus: 1 -%}
            {%- if i > 1 -%},{%- endif -%}
            {
              "@type": "ListItem",
              "position": {{ i }},
              "item": {
                "@type": "Product",
                "name": {{ product.title | append: ' - ' | append: variant.title | json }},
                "sku": {{ variant.sku | json }},
                "url": {{ product.url | append: '?variant=' | append: variant.id | prepend: shop.url | json }},
                "category": "Rubber Tracks",
                {%- if variant.featured_image -%}"image": {{ variant.featured_image | image_url: width: 800 | prepend: 'https:' | json }},{%- elsif product.featured_image -%}"image": {{ product.featured_image | image_url: width: 800 | prepend: 'https:' | json }},{%- endif -%}
                "brand": { "@type": "Brand", "name": "Heavy Iron Supply Co." },
                "isAccessoryOrSparePartFor": { "@type": "Product", "name": {{ machine_schema_name | json }} },
                "offers": {
                  "@type": "Offer",
                  "priceCurrency": {{ shop.currency | json }},
                  "price": {{ variant.price | divided_by: 100.0 | json }},
                  "availability": {% if variant.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
                  "url": {{ product.url | append: '?variant=' | append: variant.id | prepend: shop.url | json }}
                }
              }
            }
          {%- endfor -%}
        {%- else -%}
        {%- for product in model.track_products.value limit: 30 -%}
          {%- assign i = i | plus: 1 -%}
          {%- if i > 1 -%},{%- endif -%}
          {
            "@type": "ListItem",
            "position": {{ i }},
            "item": {
              "@type": "Product",
              "name": {{ product.title | json }},
              "url": {{ product.url | prepend: shop.url | json }},
              "category": "Rubber Tracks",
              {%- if product.featured_image -%}"image": {{ product.featured_image | image_url: width: 800 | prepend: 'https:' | json }},{%- endif -%}
              "brand": { "@type": "Brand", "name": "Heavy Iron Supply Co." },
              "isAccessoryOrSparePartFor": { "@type": "Product", "name": {{ machine_schema_name | json }} },
              "offers": {
                "@type": "AggregateOffer",
                "priceCurrency": {{ shop.currency | json }},
                "lowPrice": {{ product.price_min | divided_by: 100.0 | json }},
                "highPrice": {{ product.price_max | divided_by: 100.0 | json }},
                "offerCount": {{ product.variants.size }},
                "availability": {% if product.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
                "url": {{ product.url | prepend: shop.url | json }}
              }
            }
          }
        {%- endfor -%}
        {%- endif -%}
        {%- for product in model.uc_products.value limit: 30 -%}
          {%- assign i = i | plus: 1 -%}
          {%- if i > 1 -%},{%- endif -%}
          {
            "@type": "ListItem",
            "position": {{ i }},
            "item": {
              "@type": "Product",
              "name": {{ product.title | json }},
              "url": {{ product.url | prepend: shop.url | json }},
              "category": "Undercarriage",
              "brand": { "@type": "Brand", "name": "Heavy Iron Supply Co." },
              "isAccessoryOrSparePartFor": { "@type": "Product", "name": {{ machine_schema_name | json }} }
              {%- if product.price > 0 -%},
              "offers": {
                "@type": "Offer",
                "price": {{ product.price | divided_by: 100.0 | json }},
                "priceCurrency": {{ shop.currency | json }},
                "availability": {% if product.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
                "url": {{ product.url | prepend: shop.url | json }}
              }
              {%- endif -%}
            }
          }
        {%- endfor -%}
      ]
    }
    {%- if faqs != blank or faq_fallback -%}
    ,{
      "@type": "FAQPage",
      "mainEntity": [
        {%- if faqs != blank -%}
          {%- for faq in faqs -%}
            {%- unless forloop.first -%},{%- endunless -%}
            {
              "@type": "Question",
              "name": {{ faq.question | json }},
              "acceptedAnswer": { "@type": "Answer", "text": {{ faq.answer | strip_html | json }} }
            }
          {%- endfor -%}
        {%- else -%}
          {%- if track_size != blank -%}
            {%- capture faq_a1 -%}The primary governed track configuration for this machine is {{ track_size }}. Some machines have more than one confirmed configuration, so use the track options linked above and match the size marking or undercarriage configuration on your machine before choosing a width or link count.{%- endcapture -%}
          {%- else -%}
            {%- capture faq_a1 -%}This machine does not have a single primary track size published on the page. Use the governed track options linked above when available, or identify the existing track size and undercarriage configuration before ordering.{%- endcapture -%}
          {%- endif -%}
          {
            "@type": "Question",
            "name": {{ 'What size rubber tracks fit the ' | append: make_name | append: ' ' | append: model_name | append: '?' | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ faq_a1 | strip | json }} }
          },
          {
            "@type": "Question",
            "name": {{ 'How do I know a listed track fits my ' | append: model_name | append: '?' | json }},
            "acceptedAnswer": { "@type": "Answer", "text": "Track options shown on this machine page are linked from the governed fitment catalog. If the machine has multiple confirmed configurations or a serial-number split, match the selected track size to the existing track or documented undercarriage configuration before ordering." }
          },
          {
            "@type": "Question",
            "name": {{ 'How fast do ' | append: model_name | append: ' tracks ship?' | json }},
            "acceptedAnswer": { "@type": "Answer", "text": "Eligible in-stock orders placed before 12PM CT can ship the same business day. Rubber-track orders may qualify for free LTL freight within the contiguous United States; the product and checkout determine the applicable shipping terms." }
          },
          {
            "@type": "Question",
            "name": {{ 'What tread patterns are available for the ' | append: model_name | append: '?' | json }},
            "acceptedAnswer": { "@type": "Answer", "text": "Available tread patterns depend on the confirmed track size and the products currently linked to this machine. Choose the correct size first, then compare the tread options and live pricing shown in the Rubber Tracks section above." }
          },
          {
            "@type": "Question",
            "name": {{ 'Do you sell undercarriage parts for the ' | append: make_name | append: ' ' | append: model_name | append: '?' | json }},
            "acceptedAnswer": { "@type": "Answer", "text": "Sprockets, idlers, rollers, and related undercarriage components appear on this page when they are linked to the machine. For a serial-number or OEM part-number split, call (850) 816-7898 with the machine details." }
          }
        {%- endif -%}
      ]
    }
    {%- endif -%}
  ]
}
</script>
