{%- comment -%}
  Governed machine fitment helper for rubber-track PDPs.
  Uses only custom.fitments projected from the certified graph.
  It is a confidence aid, not a checkout gate, and never falls back to static fitment maps.
{%- endcomment -%}
{%- liquid
  assign fit_variant = product.selected_or_first_available_variant
  assign fit_size_ref = fit_variant.metafields.custom.track_size_reference.value
  assign hi_track_size = fit_variant.metafields.custom.track_size.value
  if hi_track_size == blank and fit_size_ref != blank
    assign hi_track_size = fit_size_ref.display_size.value | default: fit_size_ref.display_size
  endif
  if hi_track_size == blank
    assign hi_track_size = product.metafields.custom.track_size.value | default: product.metafields.custom.track_size
  endif

  assign hi_part_type = product.metafields.custom.part_type.value | downcase
  assign hi_product_type = product.type | downcase
  assign hi_is_track_product = false
  if hi_track_size != blank
    assign hi_is_track_product = true
  elsif hi_product_type contains 'track' or hi_product_type contains 'rubber'
    assign hi_is_track_product = true
  elsif hi_part_type contains 'track' or hi_part_type contains 'rubber'
    assign hi_is_track_product = true
  endif

  assign fitment_refs = product.metafields.custom.fitments.value
  assign has_governed_fitments = false
  if fitment_refs != blank and fitment_refs.size > 0
    assign has_governed_fitments = true
  endif
-%}

{%- if product != blank and product.available and hi_is_track_product and has_governed_fitments -%}
  {{ 'fitment-selector.css' | asset_url | stylesheet_tag }}
  <fitment-selector
    class="hi-fit"
    data-fit
    data-section-id="{{ section.id }}"
    data-track-size="{{ hi_track_size | escape }}"
  >
    <p class="hi-fit__label">Check your machine fit</p>
    <script type="application/json" data-fit-data>{%- render 'fitment-data', product: product, output: 'rows' -%}</script>
    <div class="hi-fit__row">
      <select name="properties[Machine Make]" class="hi-fit__select" data-fit-make aria-label="Your machine make">
        <option value="">Select make…</option>
      </select>
      <span class="hi-fit__modelwrap">
        <select name="properties[Machine Model]" class="hi-fit__select" data-fit-model-select aria-label="Your machine model" disabled>
          <option value="">Select model…</option>
        </select>
      </span>
    </div>
    {%- if hi_track_size != blank -%}
      <input data-fit-track-size type="hidden" name="properties[Track Size]" value="{{ hi_track_size | escape }}">
    {%- endif -%}
    <p class="hi-fit__ok" data-fit-ok hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="#1f7a33" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>
      <span>Verified fit in our catalog</span>
    </p>
    <p class="hi-fit__hint" data-fit-note>
      Already know your exact track size? You can order directly. Not sure which configuration your machine has?
      <button type="button" class="hi-fit__hint-link hi-fit__agent-link" data-hi-fit-agent>Find My Fit</button>
      or <a href="/pages/contact" class="hi-fit__hint-link">contact us</a> with your make, model &amp; serial.
    </p>
  </fitment-selector>
  <script src="{{ 'fitment-selector.js' | asset_url }}" defer></script>
{%- endif -%}
