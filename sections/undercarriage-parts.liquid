{%- comment -%}
  Steel Undercarriage Parts — Request a Quote grid
  Non-purchasable catalog display with quote CTA
  Heavy Iron Supply Co
{%- endcomment -%}

{%- style -%}
  .ucp-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .ucp-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="ucp ucp-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="ucp__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="ucp__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="ucp__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="ucp__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="ucp__grid ucp__grid--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'part' -%}
          <div class="ucp__card" {{ block.shopify_attributes }}>
            <div class="ucp__image-wrap">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 500 }}"
                  alt="{{ block.settings.name | escape }}"
                  class="ucp__image"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {%- else -%}
                <div class="ucp__placeholder">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                </div>
              {%- endif -%}
              <span class="ucp__badge">Quote Only</span>
            </div>
            <div class="ucp__content">
              <h3 class="ucp__name">{{ block.settings.name }}</h3>
              {%- if block.settings.fits != blank -%}
                <p class="ucp__fits">{{ block.settings.fits }}</p>
              {%- endif -%}
              {%- if block.settings.desc != blank -%}
                <p class="ucp__desc">{{ block.settings.desc }}</p>
              {%- endif -%}
              <a href="{{ section.settings.quote_url | default: '#quote-form' }}" class="ucp__cta">
                Request Quote
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} Inline quote form {%- endcomment -%}
    {%- if section.settings.show_form -%}
      <div class="ucp__form-wrap" id="quote-form">
        <div class="ucp__form-inner">
          <h3 class="ucp__form-title">Request a Quote</h3>
          <p class="ucp__form-subtitle">Tell us what you need — machine, part type, and quantity. We'll respond within one business day.</p>
          {%- form 'contact', id: 'UndercarriageQuoteForm' -%}
            {%- if form.posted_successfully? -%}
              <p class="ucp__form-success">Quote request received. We'll be in touch shortly.</p>
            {%- endif -%}
            <input type="hidden" name="contact[tags]" value="undercarriage-quote">
            <div class="ucp__form-row">
              <div class="ucp__form-field">
                <label for="ucp-name-{{ section.id }}">Name *</label>
                <input type="text" id="ucp-name-{{ section.id }}" name="contact[name]" required autocomplete="name">
              </div>
              <div class="ucp__form-field">
                <label for="ucp-email-{{ section.id }}">Email *</label>
                <input type="email" id="ucp-email-{{ section.id }}" name="contact[email]" required autocomplete="email">
              </div>
            </div>
            <div class="ucp__form-row">
              <div class="ucp__form-field">
                <label for="ucp-phone-{{ section.id }}">Phone</label>
                <input type="tel" id="ucp-phone-{{ section.id }}" name="contact[phone]" autocomplete="tel">
              </div>
              <div class="ucp__form-field">
                <label for="ucp-machine-{{ section.id }}">Machine Make & Model</label>
                <input type="text" id="ucp-machine-{{ section.id }}" name="contact[machine]" placeholder="e.g. CAT 289D">
              </div>
            </div>
            <div class="ucp__form-row ucp__form-row--full">
              <div class="ucp__form-field">
                <label for="ucp-parts-{{ section.id }}">Parts Needed & Quantity</label>
                <textarea id="ucp-parts-{{ section.id }}" name="contact[body]" placeholder="e.g. 2x bottom rollers, 1x front idler, 4x top rollers for CAT 289D"></textarea>
              </div>
            </div>
            <button type="submit" class="ucp__form-submit">Submit Quote Request</button>
          {%- endform -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.phone_text != blank -%}
      <div class="ucp__phone-bar">
        <p>{{ section.settings.phone_text }} <a href="tel:{{ section.settings.phone | remove: '(' | remove: ')' | remove: ' ' | remove: '-' }}"><strong>{{ section.settings.phone }}</strong></a></p>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .ucp__header { text-align: center; margin-bottom: 3.2rem; }
  .ucp__eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #FFB607;
    margin-bottom: 0.8rem;
  }
  .ucp__title {
    font-family: var(--font-heading-family);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
  }
  .ucp__subtitle {
    font-size: 1.4rem;
    opacity: 0.6;
    margin: 0 auto;
    max-width: 650px;
  }

  .ucp__grid {
    display: grid;
    gap: 1.6rem;
    grid-template-columns: repeat(2, 1fr);
  }
  @media screen and (min-width: 750px) {
    .ucp__grid--3 { grid-template-columns: repeat(3, 1fr); }
    .ucp__grid--4 { grid-template-columns: repeat(4, 1fr); }
  }

  .ucp__card {
    background: rgb(var(--color-background));
    border: 1px solid rgba(var(--color-foreground), 0.06);
    border-radius: 4px;
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .ucp__card:hover {
    border-color: rgba(var(--color-foreground), 0.12);
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
  }

  .ucp__image-wrap {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.03);
  }
  .ucp__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1.2rem;
  }
  .ucp__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(var(--color-foreground), 0.15);
  }

  .ucp__badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.3rem 0.8rem;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: #1a1a1a;
    color: #FFB607;
    border: 1px solid #FFB607;
    border-radius: 2px;
  }

  .ucp__content { padding: 1.4rem; }
  .ucp__name {
    font-family: var(--font-heading-family);
    font-size: 1.4rem;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 0.3rem;
  }
  .ucp__fits {
    font-size: 1.2rem;
    opacity: 0.5;
    margin: 0 0 0.4rem;
  }
  .ucp__desc {
    font-size: 1.3rem;
    opacity: 0.65;
    line-height: 1.4;
    margin: 0 0 1rem;
  }
  .ucp__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 1.2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #FFB607;
    text-decoration: none;
    transition: gap 0.2s;
  }
  .ucp__cta:hover { gap: 0.6rem; }

  /* Form */
  .ucp__form-wrap {
    max-width: 720px;
    margin: 4rem auto 0;
    padding: 3.2rem;
    background: rgba(var(--color-foreground), 0.03);
    border: 1px solid rgba(var(--color-foreground), 0.08);
    border-radius: 4px;
  }
  .ucp__form-inner {}
  .ucp__form-title {
    font-family: var(--font-heading-family);
    font-size: 1.6rem;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
  }
  .ucp__form-subtitle {
    font-size: 1.3rem;
    opacity: 0.6;
    margin: 0 0 2rem;
  }
  .ucp__form-success {
    font-weight: 600;
    color: #166534;
    font-size: 1.4rem;
    margin-bottom: 1rem;
  }
  .ucp__form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
    margin-bottom: 1.2rem;
  }
  .ucp__form-row--full { grid-template-columns: 1fr; }
  @media screen and (max-width: 749px) {
    .ucp__form-row { grid-template-columns: 1fr; }
  }
  .ucp__form-field { display: flex; flex-direction: column; gap: 0.4rem; }
  .ucp__form-field label {
    font-size: 1.2rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    opacity: 0.6;
  }
  .ucp__form-field input,
  .ucp__form-field textarea {
    width: 100%;
    padding: 1rem 1.2rem;
    border: 1px solid rgba(var(--color-foreground), 0.15);
    border-radius: 4px;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    font-size: 1.4rem;
    font-family: inherit;
  }
  .ucp__form-field input:focus,
  .ucp__form-field textarea:focus {
    outline: none;
    border-color: #FFB607;
  }
  .ucp__form-field textarea { min-height: 10rem; resize: vertical; }
  .ucp__form-submit {
    width: 100%;
    padding: 1.4rem;
    border: none;
    border-radius: 4px;
    background: #FFB607;
    color: #1a1a1a;
    font-size: 1.4rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
    font-family: var(--font-heading-family);
    transition: background 0.2s, transform 0.1s;
    margin-top: 0.8rem;
  }
  .ucp__form-submit:hover { background: #e5a406; transform: translateY(-1px); }

  .ucp__phone-bar {
    text-align: center;
    margin-top: 2.4rem;
    font-size: 1.4rem;
    opacity: 0.7;
  }
  .ucp__phone-bar a {
    color: #FFB607;
    text-decoration: none;
  }
</style>

{% schema %}
{
  "name": "Undercarriage Parts",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "STEEL UNDERCARRIAGE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Undercarriage Parts"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "OEM-spec steel undercarriage components for compact track loaders and mini excavators. Request a quote for pricing and availability."
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (desktop)",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "header",
      "content": "Quote Form"
    },
    {
      "type": "checkbox",
      "id": "show_form",
      "label": "Show inline quote form",
      "default": true
    },
    {
      "type": "url",
      "id": "quote_url",
      "label": "Quote button link",
      "info": "Where 'Request Quote' buttons go. Defaults to inline form."
    },
    {
      "type": "header",
      "content": "Phone CTA"
    },
    {
      "type": "text",
      "id": "phone_text",
      "label": "Phone CTA text",
      "default": "Need it fast? Call us direct:"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "(850) 816-7898"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "part",
      "name": "Part",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Part image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Part name",
          "default": "Bottom Rollers"
        },
        {
          "type": "text",
          "id": "fits",
          "label": "Fits",
          "info": "e.g. 'CTL / Mini Excavator'",
          "default": "CTL / Mini Excavator"
        },
        {
          "type": "text",
          "id": "desc",
          "label": "Description",
          "info": "Optional short description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Undercarriage Parts",
      "blocks": [
        { "type": "part", "settings": { "name": "Sprockets", "fits": "CTL / Mini Excavator", "desc": "Drop-forged drive sprockets for precise chain engagement." } },
        { "type": "part", "settings": { "name": "Idlers", "fits": "CTL / Mini Excavator", "desc": "OEM-spec front idlers with sealed bearings." } },
        { "type": "part", "settings": { "name": "Rollers", "fits": "CTL / Mini Excavator", "desc": "Heavy-duty sealed bottom and top rollers." } }
      ]
    }
  ]
}
{% endschema %}
