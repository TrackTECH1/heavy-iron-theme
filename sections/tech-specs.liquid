{%- comment -%}
  Tech Specs — "Why Us" split section
  Dark bg, feature list with icons, cutaway image
  Heavy Iron Supply Co
{%- endcomment -%}

{%- style -%}
  .tspec-{{ section.id }} {
    background: {{ section.settings.bg_color | default: '#1a1a1a' }};
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .tspec-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="tspec tspec-{{ section.id }}">
  <div class="page-width">
    <div class="tspec__grid">
      <div class="tspec__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="tspec__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="tspec__headline">{{ section.settings.headline }}</h2>
        {%- if section.settings.subtext != blank -%}
          <p class="tspec__subtext">{{ section.settings.subtext }}</p>
        {%- endif -%}

        <div class="tspec__features">
          {%- for block in section.blocks -%}
            <div class="tspec__feature" {{ block.shopify_attributes }}>
              <div class="tspec__feature-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFB607" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <div class="tspec__feature-text">
                <h3 class="tspec__feature-title">{{ block.settings.title }}</h3>
                <p class="tspec__feature-desc">{{ block.settings.desc }}</p>
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_url }}" class="tspec__cta">
            {{ section.settings.cta_text }}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        {%- endif -%}
      </div>

      <div class="tspec__image">
        {%- if section.settings.image -%}
          {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'tspec__img', alt: section.settings.headline }}
        {%- else -%}
          <div class="tspec__placeholder">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#444" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
            <span>Track Cutaway Image</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .tspec__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.2rem;
    align-items: center;
  }
  @media screen and (min-width: 750px) {
    .tspec__grid {
      grid-template-columns: 1fr 1fr;
      gap: 4.8rem;
    }
  }

  .tspec__eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #FFB607;
    margin-bottom: 1rem;
  }

  .tspec__headline {
    font-family: var(--font-heading-family);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 900;
    color: #fff;
    text-transform: uppercase;
    line-height: 1.1;
    margin: 0 0 1rem;
  }

  .tspec__subtext {
    font-size: 1.4rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.6;
    margin: 0 0 2.4rem;
  }

  .tspec__features {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .tspec__feature {
    display: flex;
    gap: 1.2rem;
    align-items: flex-start;
  }

  .tspec__feature-icon {
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .tspec__feature-title {
    font-family: var(--font-heading-family);
    font-size: 1.3rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #fff;
    margin: 0 0 0.3rem;
  }

  .tspec__feature-desc {
    font-size: 1.3rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.5;
    margin: 0;
  }

  .tspec__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 2.4rem;
    padding: 1.2rem 2.4rem;
    font-size: 1.3rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    background: #FFB607;
    color: #1a1a1a;
    text-decoration: none;
    border-radius: 4px;
    font-family: var(--font-heading-family);
    transition: all 0.15s;
  }
  .tspec__cta:hover {
    background: #e5a406;
    transform: translateY(-2px);
  }

  .tspec__image { position: relative; }
  .tspec__img {
    width: 100%;
    height: auto;
    border-radius: 4px;
    display: block;
  }
  .tspec__placeholder {
    aspect-ratio: 4/3;
    background: #2a2a2a;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: #555;
    font-size: 1.2rem;
  }
</style>

{% schema %}
{
  "name": "Tech Specs",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ENGINEERED FOR THE JOBSITE"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Built to Endure the Toughest Job Sites."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Every track is manufactured to OEM tolerances with materials that outlast recycled-rubber competitors."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Cutaway / product image",
      "info": "Track cross-section or 3D render works best. 800x600px+"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA button text",
      "default": "Shop All Tracks"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA button link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "desc",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tech Specs",
      "blocks": [
        { "type": "feature", "settings": { "title": "Direct OEM Fit", "desc": "Precision-engineered to match factory track dimensions, guide types, and lug counts." } },
        { "type": "feature", "settings": { "title": "ISO 9001 Certified", "desc": "Manufactured under international quality management standards." } },
        { "type": "feature", "settings": { "title": "Cut-Resistant Rubber", "desc": "Heavy-duty virgin rubber compound resists chunking and tearing on abrasive surfaces." } },
        { "type": "feature", "settings": { "title": "High-Traction, Low-Vibration", "desc": "Optimized tread geometry for maximum grip with reduced operator fatigue." } },
        { "type": "feature", "settings": { "title": "Continuous Steel Cord", "desc": "No overlapping joints. Single-loop cord eliminates the #1 failure point in rubber tracks." } },
        { "type": "feature", "settings": { "title": "Anti-Corrosion Guides", "desc": "Drop-forged steel track guides with corrosion-resistant treatment for extended life." } },
        { "type": "feature", "settings": { "title": "24-Month Warranty", "desc": "Full manufacturer warranty on materials and workmanship. Not prorated." } }
      ]
    }
  ]
}
{% endschema %}
