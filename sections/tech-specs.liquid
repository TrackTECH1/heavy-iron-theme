{%- comment -%}
  Tech Specs — "Why Us" split section
  Dark bg, feature list with icons, cutaway image
  Heavy Iron Supply Co — copy adapts on product pages (tracks vs attachments vs undercarriage)
{%- endcomment -%}

{%- liquid
  assign tspec_eyebrow = section.settings.eyebrow
  assign tspec_headline = section.settings.headline
  assign tspec_subtext = section.settings.subtext
  assign tspec_cta_text = section.settings.cta_text
  assign tspec_cta_url = section.settings.cta_url
  assign tspec_image = section.settings.image
  assign tspec_use_blocks = true
  assign tspec_placeholder = 'Track cutaway image'
  assign hi_is_attachment = false
  assign hi_is_undercarriage = false
  assign hi_is_track = true

  if product
    assign hi_track_size = product.metafields.custom.track_size.value
    assign hi_part_type = product.metafields.custom.part_type.value | downcase
    assign hi_product_type = product.type | downcase

    assign hi_is_track = false
    if hi_track_size != blank
      assign hi_is_track = true
    elsif hi_product_type contains 'track' or hi_product_type contains 'rubber'
      assign hi_is_track = true
    elsif hi_part_type contains 'track' or hi_part_type contains 'rubber'
      assign hi_is_track = true
    endif

    assign hi_is_attachment = false
    if hi_part_type contains 'attachment' or hi_product_type contains 'attachment'
      assign hi_is_attachment = true
    endif

    assign hi_is_undercarriage = false
    if hi_part_type contains 'undercarriage' or hi_part_type contains 'sprocket' or hi_part_type contains 'roller' or hi_part_type contains 'idler'
      assign hi_is_undercarriage = true
    elsif hi_product_type contains 'undercarriage' or hi_product_type contains 'sprocket' or hi_product_type contains 'roller' or hi_product_type contains 'idler'
      assign hi_is_undercarriage = true
    endif

    if hi_is_track == false and hi_is_undercarriage == false
      assign hi_is_attachment = true
    endif

    if hi_is_attachment
      assign tspec_use_blocks = false
      assign tspec_eyebrow = 'ENGINEERED FOR THE JOBSITE'
      assign tspec_headline = 'Built Tough'
      assign tspec_subtext = "Contractor-grade attachments built for daily abuse — matched to your machine's mount, flow, and hydraulic requirements."
      assign tspec_cta_text = 'Shop All Attachments'
      assign tspec_cta_url = '/collections/attachments'
      assign tspec_placeholder = 'Attachment image'
      if product.featured_image
        assign tspec_image = product.featured_image
      endif
    elsif hi_is_undercarriage
      assign tspec_use_blocks = false
      assign tspec_eyebrow = 'STEEL UNDERCARRIAGE'
      assign tspec_headline = 'Built Tough'
      assign tspec_subtext = 'OEM-cross-referenced sprockets, idlers, and rollers — drop-in fit for compact track loaders and mini excavators.'
      assign tspec_cta_text = 'Shop Undercarriage Parts'
      assign tspec_cta_url = '/collections/undercarriage-parts'
      assign tspec_placeholder = 'Undercarriage part image'
      if product.featured_image
        assign tspec_image = product.featured_image
      endif
    endif
  endif
-%}

{%- style -%}
  .tspec-{{ section.id }} {
    background: {{ section.settings.bg_color | default: '#1a1a1a' }};
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .tspec-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="tspec tspec-{{ section.id }}">
  <div class="page-width">
    <div class="tspec__grid">
      <div class="tspec__content">
        {%- if tspec_eyebrow != blank -%}
          <span class="tspec__eyebrow">{{ tspec_eyebrow }}</span>
        {%- endif -%}
        <h2 class="tspec__headline">{{ tspec_headline }}</h2>
        {%- if tspec_subtext != blank -%}
          <p class="tspec__subtext">{{ tspec_subtext }}</p>
        {%- endif -%}

        <div class="tspec__features">
          {%- if hi_is_attachment -%}
            <div class="tspec__feature">
              <div class="tspec__feature-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFB607" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <div class="tspec__feature-text">
                <h3 class="tspec__feature-title">Guaranteed Machine Fit</h3>
                <p class="tspec__feature-desc">Universal, skid-steer, and mini excavator mounts — we confirm fitment by make, model, and serial before you order.</p>
              </div>
            </div>
            <div class="tspec__feature">
              <div class="tspec__feature-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFB607" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <div class="tspec__feature-text">
                <h3 class="tspec__feature-title">Heavy-Duty Construction</h3>
                <p class="tspec__feature-desc">AR400 steel, reinforced bushings, and sealed bearings built for land clearing, forestry, and daily site work.</p>
              </div>
            </div>
            <div class="tspec__feature">
              <div class="tspec__feature-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFB607" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <div class="tspec__feature-text">
                <h3 class="tspec__feature-title">Free Freight Nationwide</h3>
                <p class="tspec__feature-desc">Every attachment ships free to the contiguous US. No liftgate fees, no hidden freight charges.</p>
              </div>
            </div>
            <div class="tspec__feature">
              <div class="tspec__feature-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFB607" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <div class="tspec__feature-text">
                <h3 class="tspec__feature-title">Same-Day Shipping</h3>
                <p class="tspec__feature-desc">Order by 12pm CT and your attachment ships same business day from our US warehouses.</p>
              </div>
            </div>
            <div class="tspec__feature">
              <div class="tspec__feature-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFB607" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <div class="tspec__feature-text">
                <h3 class="tspec__feature-title">12-Month Limited Warranty</h3>
                <p class="tspec__feature-desc">CID manufacturer coverage on defects in materials and workmanship for 12 months from purchase. Wear items such as blades, hoses, and ground-engaging parts are not covered.</p>
              </div>
            </div>
          {%- elsif hi_is_undercarriage -%}
            <div class="tspec__feature">
              <div class="tspec__feature-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFB607" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <div class="tspec__feature-text">
                <h3 class="tspec__feature-title">OEM-Cross-Referenced</h3>
                <p class="tspec__feature-desc">Sprockets, idlers, and rollers matched to factory part numbers for drop-in replacement.</p>
              </div>
            </div>
            <div class="tspec__feature">
              <div class="tspec__feature-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFB607" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <div class="tspec__feature-text">
                <h3 class="tspec__feature-title">Drop-Forged Steel</h3>
                <p class="tspec__feature-desc">Heat-treated sprockets and sealed rollers built for abrasive underfoot conditions.</p>
              </div>
            </div>
            <div class="tspec__feature">
              <div class="tspec__feature-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFB607" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <div class="tspec__feature-text">
                <h3 class="tspec__feature-title">Free Freight Nationwide</h3>
                <p class="tspec__feature-desc">Steel undercarriage parts ship free to the contiguous US on every order.</p>
              </div>
            </div>
            <div class="tspec__feature">
              <div class="tspec__feature-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFB607" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <div class="tspec__feature-text">
                <h3 class="tspec__feature-title">24-Month Warranty</h3>
                <p class="tspec__feature-desc">Full manufacturer warranty on materials and workmanship. Not prorated.</p>
              </div>
            </div>
          {%- else -%}
          {%- for block in section.blocks -%}
            <div class="tspec__feature" {{ block.shopify_attributes }}>
              <div class="tspec__feature-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFB607" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <div class="tspec__feature-text">
                <h3 class="tspec__feature-title">{{ block.settings.title }}</h3>
                <p class="tspec__feature-desc">{{ block.settings.desc }}</p>
              </div>
            </div>
          {%- endfor -%}
          {%- endif -%}
        </div>

        {%- if tspec_cta_text != blank -%}
          <a href="{{ tspec_cta_url | default: '/collections/rubber-tracks' }}" class="tspec__cta">
            {{ tspec_cta_text }}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        {%- endif -%}
      </div>

      <div class="tspec__image">
        {%- if tspec_image -%}
          {{ tspec_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'tspec__img', alt: tspec_headline }}
        {%- else -%}
          <div class="tspec__placeholder">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#444" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
            <span>{{ tspec_placeholder }}</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .tspec__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.2rem;
    align-items: center;
  }
  @media screen and (min-width: 750px) {
    .tspec__grid {
      grid-template-columns: 1fr 1fr;
      gap: 4.8rem;
    }
  }

  .tspec__eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #FFB607;
    margin-bottom: 1rem;
  }

  .tspec__headline {
    font-family: var(--font-heading-family);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 900;
    color: #fff;
    text-transform: uppercase;
    line-height: 1.1;
    margin: 0 0 1rem;
  }

  .tspec__subtext {
    font-size: 1.4rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.6;
    margin: 0 0 2.4rem;
  }

  .tspec__features {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .tspec__feature {
    display: flex;
    gap: 1.2rem;
    align-items: flex-start;
  }

  .tspec__feature-icon {
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .tspec__feature-title {
    font-family: var(--font-heading-family);
    font-size: 1.3rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #fff;
    margin: 0 0 0.3rem;
  }

  .tspec__feature-desc {
    font-size: 1.3rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.5;
    margin: 0;
  }

  .tspec__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 2.4rem;
    padding: 1.2rem 2.4rem;
    font-size: 1.3rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    background: #FFB607;
    color: #1a1a1a;
    text-decoration: none;
    border-radius: 4px;
    font-family: var(--font-heading-family);
    transition: all 0.15s;
  }
  .tspec__cta:hover {
    background: #e5a406;
    transform: translateY(-2px);
  }

  .tspec__image { position: relative; }
  .tspec__img {
    width: 100%;
    height: auto;
    border-radius: 4px;
    display: block;
  }
  .tspec__placeholder {
    aspect-ratio: 4/3;
    background: #2a2a2a;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: #555;
    font-size: 1.2rem;
  }
</style>

{% schema %}
{
  "name": "Tech Specs",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ENGINEERED FOR THE JOBSITE"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Built to Endure the Toughest Job Sites."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Every track is manufactured to OEM tolerances with materials that outlast recycled-rubber competitors."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Cutaway / product image",
      "info": "Track cross-section or 3D render works best. 800x600px+"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA button text",
      "default": "Shop All Tracks"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA button link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "desc",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tech Specs",
      "blocks": [
        { "type": "feature", "settings": { "title": "Direct OEM Fit", "desc": "Precision-engineered to match factory track dimensions, guide types, and lug counts." } },
        { "type": "feature", "settings": { "title": "ISO 9001 Certified", "desc": "Manufactured under international quality management standards." } },
        { "type": "feature", "settings": { "title": "Cut-Resistant Rubber", "desc": "Heavy-duty virgin rubber compound resists chunking and tearing on abrasive surfaces." } },
        { "type": "feature", "settings": { "title": "High-Traction, Low-Vibration", "desc": "Optimized tread geometry for maximum grip with reduced operator fatigue." } },
        { "type": "feature", "settings": { "title": "Continuous Steel Cord", "desc": "No overlapping joints. Single-loop cord eliminates the #1 failure point in rubber tracks." } },
        { "type": "feature", "settings": { "title": "Anti-Corrosion Guides", "desc": "Drop-forged steel track guides with corrosion-resistant treatment for extended life." } },
        { "type": "feature", "settings": { "title": "24-Month Warranty", "desc": "Full manufacturer warranty on materials and workmanship. Not prorated." } }
      ]
    }
  ]
}
{% endschema %}
