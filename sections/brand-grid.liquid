{%- comment -%}
  Premium Text-Based Brand Navigation
{%- endcomment -%}

{%- style -%}
  .brand-nav {
    padding: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px 0 {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .brand-nav {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
  }
  .brand-nav__heading {
    text-transform: uppercase;
    letter-spacing: -0.02em;
    text-align: center;
    margin: 0 0 0.6rem;
  }
  .brand-nav__subtext {
    text-align: center;
    margin: 0 0 3.2rem;
    opacity: 0.6;
    font-size: 1.4rem;
  }
  
  /* GRID LAYOUT FOR TEXT TILES */
  .brand-nav__list {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.gap }}px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* PREMIUM TEXT TILE STYLING */
  .brand-nav__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(145deg, rgb(var(--color-background)) 0%, rgba(var(--color-foreground), 0.03) 100%);
    border: 1px solid rgba(var(--color-foreground), 0.08);
    border-radius: 6px;
    padding: 1.6rem 2rem;
    text-decoration: none;
    color: rgba(var(--color-foreground), 0.8);
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    box-shadow: 0 2px 8px rgba(0,0,0,0.02);
  }

  .brand-nav__name {
    font-size: 1.3rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color 0.3s ease;
  }

  /* HOVER LIFT & YELLOW ACCENT */
  .brand-nav__item:hover {
    border-color: #EAB308; /* Premium Industrial Yellow */
    box-shadow: 0 6px 16px rgba(0,0,0,0.06);
    transform: translateY(-3px);
    color: rgb(var(--color-foreground));
  }

  /* ARROW STYLING & ANIMATION */
  .brand-nav__arrow {
    display: flex;
    align-items: center;
    color: #EAB308;
    opacity: 0;
    transform: translateX(-10px);
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .brand-nav__arrow svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .brand-nav__item:hover .brand-nav__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* MOBILE OPTIMIZATIONS */
  @media screen and (max-width: 989px) {
    .brand-nav__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media screen and (max-width: 749px) {
    .brand-nav__list {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      gap: 8px;
    }
    .brand-nav__item {
      padding: 1.4rem 1.2rem;
    }
    .brand-nav__name {
      font-size: 1.1rem;
    }
    /* Always show a subtle arrow on mobile since there is no hover */
    .brand-nav__arrow {
      opacity: 0.5;
      transform: translateX(0);
    }
  }
{%- endstyle -%}

<div class="brand-nav color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="brand-nav__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subtext != blank -%}
      <p class="brand-nav__subtext">{{ section.settings.subtext }}</p>
    {%- endif -%}

    <ul class="brand-nav__list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          {%- assign brand_name = block.settings.brand_name | default: 'Brand Name' -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="brand-nav__item">
          {%- else -%}
            <div class="brand-nav__item">
          {%- endif -%}

            <span class="brand-nav__name">{{ brand_name }}</span>
            <span class="brand-nav__arrow">
              <svg viewBox="0 0 14 10" fill="none" aria-hidden="true" focusable="false">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M8.537.808a.5.5 0 01.817-.162l4 4a.5.5 0 010 .708l-4 4a.5.5 0 11-.708-.708L11.793 5.5H1a.5.5 0 010-1h10.793L8.646 1.354a.5.5 0 01-.109-.546z" fill="currentColor"></path>
              </svg>
            </span>

          {%- if block.settings.link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Brand Navigation",
  "tag": "section",
  "class": "section",
  "max_blocks": 50,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Brand"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Select your equipment manufacturer to find exact-fit parts."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h3", "label": "Small" },
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Gap between blocks",
      "default": 16
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "text",
          "id": "brand_name",
          "label": "Brand name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Link to brand collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Navigation",
      "blocks": [
        { "type": "brand", "settings": { "brand_name": "Bobcat" } },
        { "type": "brand", "settings": { "brand_name": "CAT" } },
        { "type": "brand", "settings": { "brand_name": "Case" } },
        { "type": "brand", "settings": { "brand_name": "Ditch Witch" } },
        { "type": "brand", "settings": { "brand_name": "Gehl" } },
        { "type": "brand", "settings": { "brand_name": "Hitachi" } },
        { "type": "brand", "settings": { "brand_name": "JCB" } },
        { "type": "brand", "settings": { "brand_name": "John Deere" } }
      ]
    }
  ]
}
{% endschema %}