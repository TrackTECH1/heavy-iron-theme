{%- comment -%}
  Fleet Quote Request — Inline form section
  Drop on homepage, collection pages, or standalone page
{%- endcomment -%}

{%- style -%}
  .fqf-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .fqf-{{ section.id }} {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
  }

  .fqf__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.2rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  @media screen and (min-width: 750px) {
    .fqf__inner {
      grid-template-columns: 1fr 1.2fr;
      gap: 4.8rem;
      align-items: start;
    }
  }

  .fqf__copy {}
  .fqf__label {
    display: block;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #FFB607;
    margin-bottom: 1.2rem;
  }
  .fqf__heading {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1.1;
    margin: 0 0 1.2rem;
    color: rgb(var(--color-foreground));
    font-family: var(--font-heading-family);
  }
  .fqf__subtext {
    font-size: 1.5rem;
    line-height: 1.6;
    opacity: 0.7;
    margin: 0 0 2.4rem;
  }
  .fqf__benefits {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .fqf__benefit {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.4rem;
    font-weight: 500;
  }
  .fqf__check {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    background: #FFB607;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    color: #1a1a1a;
    font-weight: 800;
  }
  .fqf__phone {
    margin-top: 2.4rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(var(--color-foreground), 0.1);
  }
  .fqf__phone-label {
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    opacity: 0.5;
    margin-bottom: 0.4rem;
  }
  .fqf__phone-number {
    font-size: 2rem;
    font-weight: 800;
    font-family: var(--font-heading-family);
    color: rgb(var(--color-foreground));
    text-decoration: none;
  }
  .fqf__phone-number:hover {
    color: #FFB607;
  }
  .fqf__phone-hours {
    font-size: 1.2rem;
    opacity: 0.5;
    margin-top: 0.4rem;
  }

  /* Form */
  .fqf__form-wrap {
    background: rgb(var(--color-background));
    border: 1px solid rgba(var(--color-foreground), 0.08);
    border-radius: 4px;
    padding: 2.8rem;
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
  }
  .fqf__form-title {
    font-size: 1.5rem;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 2rem;
    font-family: var(--font-heading-family);
  }
  .fqf__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
    margin-bottom: 1.2rem;
  }
  .fqf__row--full {
    grid-template-columns: 1fr;
  }
  @media screen and (max-width: 749px) {
    .fqf__row { grid-template-columns: 1fr; }
  }
  .fqf__field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .fqf__field label {
    font-size: 1.2rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    opacity: 0.6;
  }
  .fqf__field input,
  .fqf__field select,
  .fqf__field textarea {
    width: 100%;
    padding: 1rem 1.2rem;
    border: 1px solid rgba(var(--color-foreground), 0.15);
    border-radius: 4px;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    font-size: 1.4rem;
    font-family: inherit;
  }
  .fqf__field input:focus,
  .fqf__field select:focus,
  .fqf__field textarea:focus {
    outline: none;
    border-color: #FFB607;
  }
  .fqf__field textarea {
    min-height: 10rem;
    resize: vertical;
  }
  .fqf__submit {
    width: 100%;
    padding: 1.4rem;
    border: none;
    border-radius: 4px;
    background: #FFB607;
    color: #1a1a1a;
    font-size: 1.5rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
    font-family: var(--font-heading-family);
    transition: background 0.2s, transform 0.1s;
    margin-top: 0.8rem;
  }
  .fqf__submit:hover {
    background: #e5a406;
    transform: translateY(-1px);
  }
  .fqf__submit:active {
    transform: translateY(0);
  }
  .fqf__disclaimer {
    font-size: 1.1rem;
    opacity: 0.4;
    margin-top: 1.2rem;
    text-align: center;
  }
{%- endstyle -%}

<section class="fqf-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="fqf__inner">

      <div class="fqf__copy">
        {%- if section.settings.label != blank -%}
          <span class="fqf__label">{{ section.settings.label }}</span>
        {%- endif -%}
        <h2 class="fqf__heading">{{ section.settings.heading }}</h2>
        <p class="fqf__subtext">{{ section.settings.subtext }}</p>

        <ul class="fqf__benefits">
          {%- for block in section.blocks -%}
            {%- if block.type == 'benefit' -%}
              <li class="fqf__benefit" {{ block.shopify_attributes }}>
                <span class="fqf__check">✓</span>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        <div class="fqf__phone">
          <div class="fqf__phone-label">Prefer to call?</div>
          <a href="tel:{{ section.settings.phone | remove: '(' | remove: ')' | remove: ' ' | remove: '-' }}" class="fqf__phone-number">{{ section.settings.phone }}</a>
          <div class="fqf__phone-hours">{{ section.settings.hours }}</div>
        </div>
      </div>

      <div class="fqf__form-wrap">
        <div class="fqf__form-title">Get Your Fleet Quote</div>
        {%- form 'contact', id: 'FleetQuoteForm' -%}
          {%- if form.posted_successfully? -%}
            <p style="color:#166534;font-weight:600;font-size:1.5rem;margin-bottom:1rem;">Quote request received. We'll be in touch within one business day.</p>
          {%- endif -%}

          <input type="hidden" name="contact[tags]" value="fleet-quote">

          <div class="fqf__row">
            <div class="fqf__field">
              <label for="fqf-name-{{ section.id }}">Name *</label>
              <input type="text" id="fqf-name-{{ section.id }}" name="contact[name]" required autocomplete="name">
            </div>
            <div class="fqf__field">
              <label for="fqf-company-{{ section.id }}">Company</label>
              <input type="text" id="fqf-company-{{ section.id }}" name="contact[company]" autocomplete="organization">
            </div>
          </div>

          <div class="fqf__row">
            <div class="fqf__field">
              <label for="fqf-email-{{ section.id }}">Email *</label>
              <input type="email" id="fqf-email-{{ section.id }}" name="contact[email]" required autocomplete="email">
            </div>
            <div class="fqf__field">
              <label for="fqf-phone-{{ section.id }}">Phone</label>
              <input type="tel" id="fqf-phone-{{ section.id }}" name="contact[phone]" autocomplete="tel">
            </div>
          </div>

          <div class="fqf__row">
            <div class="fqf__field">
              <label for="fqf-fleet-{{ section.id }}">Fleet Size</label>
              <select id="fqf-fleet-{{ section.id }}" name="contact[fleet_size]">
                <option value="">Select...</option>
                <option value="1-5">1–5 machines</option>
                <option value="6-15">6–15 machines</option>
                <option value="16-50">16–50 machines</option>
                <option value="50+">50+ machines</option>
              </select>
            </div>
            <div class="fqf__field">
              <label for="fqf-type-{{ section.id }}">Account Type</label>
              <select id="fqf-type-{{ section.id }}" name="contact[account_type]">
                <option value="">Select...</option>
                <option value="rental">Rental Yard</option>
                <option value="contractor">Contractor</option>
                <option value="municipality">Municipality</option>
                <option value="dealer">Equipment Dealer</option>
                <option value="other">Other</option>
              </select>
            </div>
          </div>

          <div class="fqf__row fqf__row--full">
            <div class="fqf__field">
              <label for="fqf-msg-{{ section.id }}">Machines & Quantities</label>
              <textarea id="fqf-msg-{{ section.id }}" name="contact[body]" placeholder="Example: 3x CAT 289D, 2x Bobcat T770, 1x Kubota SVL95-2"></textarea>
            </div>
          </div>

          <button type="submit" class="fqf__submit">Request Fleet Quote</button>
          <div class="fqf__disclaimer">We respond within one business day. No spam, ever.</div>
        {%- endform -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fleet Quote Form",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Top label",
      "default": "FLEET & WHOLESALE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Managing a Fleet?"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Volume pricing for rental yards, municipalities, and contractor fleets. One call, every machine covered."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "(850) 816-7898"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Business hours",
      "default": "Monday–Friday, 8am–5pm CT"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Benefit text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fleet Quote Form",
      "blocks": [
        { "type": "benefit", "settings": { "text": "Volume pricing on multi-unit orders" } },
        { "type": "benefit", "settings": { "text": "Free freight — contiguous US" } },
        { "type": "benefit", "settings": { "text": "24-month warranty on every track" } },
        { "type": "benefit", "settings": { "text": "Dedicated fleet account rep" } },
        { "type": "benefit", "settings": { "text": "All major brands in stock" } }
      ]
    }
  ]
}
{% endschema %}
