{%- comment -%}
  Silo Links Grid — Internal link clusters for SEO + navigation
  Adapted for Heavy Iron Supply Co / Trade theme
{%- endcomment -%}

{%- style -%}
  .silo-links-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .silo-links-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="silo-links silo-links-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="silo-links__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="silo-links__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    <nav class="silo-links__grid silo-links__grid--{{ section.blocks.size | at_most: 4 }}" aria-label="Site navigation">
      {%- for block in section.blocks -%}
        {%- if block.type == 'column' -%}
          <div class="silo-links__column" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="silo-links__heading">
                {%- if block.settings.icon != 'none' -%}
                  <span class="silo-links__icon">
                    {%- case block.settings.icon -%}
                      {%- when 'ruler' -%}
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.3 15.3l-13-13a1 1 0 00-1.4 0l-4.9 4.9a1 1 0 000 1.4l13 13a1 1 0 001.4 0l4.9-4.9a1 1 0 000-1.4z"/><path d="M14 7l3 3M10 11l3 3M6 15l3 3"/></svg>
                      {%- when 'tag' -%}
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><circle cx="7" cy="7" r="1"/></svg>
                      {%- when 'truck' -%}
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                      {%- when 'grid' -%}
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                      {%- when 'layers' -%}
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                    {%- endcase -%}
                  </span>
                {%- endif -%}
                {{ block.settings.heading }}
              </h3>
            {%- endif -%}

            <ul class="silo-links__list">
              {%- if block.settings.collection != blank -%}
                {%- assign link_collection = block.settings.collection -%}
                {%- assign max_links = block.settings.max_links | default: 8 -%}
                {%- for product in link_collection.products limit: max_links -%}
                  <li>
                    <a href="{{ product.url }}" class="silo-links__link">
                      {{ product.title | split: ' - ' | first | split: ' | ' | first }}
                    </a>
                  </li>
                {%- endfor -%}
              {%- elsif block.settings.menu != blank -%}
                {%- assign max_links = block.settings.max_links | default: 8 -%}
                {%- for link in linklists[block.settings.menu].links limit: max_links -%}
                  <li>
                    <a href="{{ link.url }}" class="silo-links__link">{{ link.title }}</a>
                  </li>
                {%- endfor -%}
              {%- else -%}
                {%- if block.settings.link_1_text != blank -%}<li><a href="{{ block.settings.link_1_url }}" class="silo-links__link">{{ block.settings.link_1_text }}</a></li>{%- endif -%}
                {%- if block.settings.link_2_text != blank -%}<li><a href="{{ block.settings.link_2_url }}" class="silo-links__link">{{ block.settings.link_2_text }}</a></li>{%- endif -%}
                {%- if block.settings.link_3_text != blank -%}<li><a href="{{ block.settings.link_3_url }}" class="silo-links__link">{{ block.settings.link_3_text }}</a></li>{%- endif -%}
                {%- if block.settings.link_4_text != blank -%}<li><a href="{{ block.settings.link_4_url }}" class="silo-links__link">{{ block.settings.link_4_text }}</a></li>{%- endif -%}
                {%- if block.settings.link_5_text != blank -%}<li><a href="{{ block.settings.link_5_url }}" class="silo-links__link">{{ block.settings.link_5_text }}</a></li>{%- endif -%}
                {%- if block.settings.link_6_text != blank -%}<li><a href="{{ block.settings.link_6_url }}" class="silo-links__link">{{ block.settings.link_6_text }}</a></li>{%- endif -%}
                {%- if block.settings.link_7_text != blank -%}<li><a href="{{ block.settings.link_7_url }}" class="silo-links__link">{{ block.settings.link_7_text }}</a></li>{%- endif -%}
                {%- if block.settings.link_8_text != blank -%}<li><a href="{{ block.settings.link_8_url }}" class="silo-links__link">{{ block.settings.link_8_text }}</a></li>{%- endif -%}
              {%- endif -%}
            </ul>

            {%- if block.settings.view_all_text != blank and block.settings.view_all_url != blank -%}
              <a href="{{ block.settings.view_all_url }}" class="silo-links__view-all">
                {{ block.settings.view_all_text }}
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </nav>
  </div>
</div>

<style>
  .silo-links__title {
    text-align: center;
    font-family: var(--font-heading-family);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 0 0 0.5rem;
  }
  .silo-links__subtitle {
    text-align: center;
    font-size: 1.4rem;
    opacity: 0.6;
    margin: 0 0 2.8rem;
  }

  .silo-links__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media screen and (min-width: 550px) {
    .silo-links__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media screen and (min-width: 990px) {
    .silo-links__grid--2 { grid-template-columns: repeat(2, 1fr); }
    .silo-links__grid--3 { grid-template-columns: repeat(3, 1fr); }
    .silo-links__grid--4 { grid-template-columns: repeat(4, 1fr); gap: 2.4rem; }
  }

  .silo-links__column {
    border: 1px solid rgba(var(--color-foreground), 0.06);
    border-radius: 4px;
    padding: 2rem;
    background: rgba(var(--color-background), 0.5);
  }

  .silo-links__heading {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-heading-family);
    font-size: 1.3rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 1.2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #FFB607;
  }
  .silo-links__icon {
    display: flex;
    color: #FFB607;
  }

  .silo-links__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .silo-links__link {
    display: block;
    font-size: 1.35rem;
    color: rgb(var(--color-foreground));
    text-decoration: none;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.04);
    transition: color 0.2s, padding-left 0.2s;
  }
  .silo-links__link:hover {
    color: #FFB607;
    padding-left: 0.6rem;
  }

  .silo-links__view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 1.2rem;
    font-size: 1.2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #FFB607;
    text-decoration: none;
    transition: gap 0.2s;
  }
  .silo-links__view-all:hover {
    gap: 0.6rem;
  }
</style>

{% schema %}
{
  "name": "Silo Links Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Quick Links"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Find exactly what you need"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop by Size"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "ruler", "label": "Ruler (Size)" },
            { "value": "tag", "label": "Tag (Brand)" },
            { "value": "truck", "label": "Truck (Machine)" },
            { "value": "grid", "label": "Grid (Tread)" },
            { "value": "layers", "label": "Layers (Category)" }
          ],
          "default": "ruler"
        },
        {
          "type": "header",
          "content": "Auto-populate"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "From collection"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Or from menu"
        },
        {
          "type": "range",
          "id": "max_links",
          "min": 4,
          "max": 12,
          "step": 1,
          "label": "Max links",
          "default": 8
        },
        {
          "type": "header",
          "content": "Manual Links"
        },
        { "type": "text", "id": "link_1_text", "label": "Link 1 text" },
        { "type": "url", "id": "link_1_url", "label": "Link 1 URL" },
        { "type": "text", "id": "link_2_text", "label": "Link 2 text" },
        { "type": "url", "id": "link_2_url", "label": "Link 2 URL" },
        { "type": "text", "id": "link_3_text", "label": "Link 3 text" },
        { "type": "url", "id": "link_3_url", "label": "Link 3 URL" },
        { "type": "text", "id": "link_4_text", "label": "Link 4 text" },
        { "type": "url", "id": "link_4_url", "label": "Link 4 URL" },
        { "type": "text", "id": "link_5_text", "label": "Link 5 text" },
        { "type": "url", "id": "link_5_url", "label": "Link 5 URL" },
        { "type": "text", "id": "link_6_text", "label": "Link 6 text" },
        { "type": "url", "id": "link_6_url", "label": "Link 6 URL" },
        { "type": "text", "id": "link_7_text", "label": "Link 7 text" },
        { "type": "url", "id": "link_7_url", "label": "Link 7 URL" },
        { "type": "text", "id": "link_8_text", "label": "Link 8 text" },
        { "type": "url", "id": "link_8_url", "label": "Link 8 URL" },
        {
          "type": "header",
          "content": "View All"
        },
        { "type": "text", "id": "view_all_text", "label": "View all text", "default": "View All" },
        { "type": "url", "id": "view_all_url", "label": "View all URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Silo Links Grid",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "heading": "Shop by Brand",
            "icon": "tag",
            "link_1_text": "Bobcat Tracks",
            "link_2_text": "CAT Tracks",
            "link_3_text": "John Deere Tracks",
            "link_4_text": "Kubota Tracks",
            "link_5_text": "Takeuchi Tracks",
            "link_6_text": "Case Tracks",
            "view_all_text": "View All Brands"
          }
        },
        {
          "type": "column",
          "settings": {
            "heading": "Shop by Machine",
            "icon": "truck",
            "link_1_text": "Compact Track Loaders",
            "link_2_text": "Mini Excavators",
            "link_3_text": "Skid Steers",
            "link_4_text": "Multi-Terrain Loaders",
            "view_all_text": "View All Equipment"
          }
        },
        {
          "type": "column",
          "settings": {
            "heading": "Popular Models",
            "icon": "grid",
            "link_1_text": "Bobcat T770",
            "link_2_text": "CAT 289D",
            "link_3_text": "John Deere 333G",
            "link_4_text": "Kubota SVL95-2",
            "link_5_text": "Takeuchi TL12R2",
            "link_6_text": "Case TV370",
            "view_all_text": "View All Models"
          }
        },
        {
          "type": "column",
          "settings": {
            "heading": "Support",
            "icon": "layers",
            "link_1_text": "Track Finder",
            "link_2_text": "Warranty Info",
            "link_3_text": "Shipping & Delivery",
            "link_4_text": "Contact Us",
            "link_5_text": "FAQ",
            "view_all_text": "Get Help"
          }
        }
      ]
    }
  ]
}
{% endschema %}
