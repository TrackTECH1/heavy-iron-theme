{%- comment -%}
  Heavy Iron Supply Co — Machine Smart Collection Hub
  Source: Smart Collection + machine tags. Optional collection metafields:
    custom.machine_key, custom.machine_make, custom.machine_model
  Product grouping: collection tag filters.
{%- endcomment -%}

{%- liquid
  assign accent = section.settings.accent_color | default: '#FFB607'
  assign machine_make = collection.metafields.custom.machine_make | default: ''
  assign machine_model = collection.metafields.custom.machine_model | default: ''
  if machine_make == blank
    assign machine_make = collection.title | split: ' ' | first
  endif
  assign is_machine = false
  if machine_model != blank
    assign is_machine = true
  endif
  assign base_url = collection.url
  assign machine_make_handle = machine_make | handleize
  assign make_collection_url = routes.collections_url | append: '/' | append: machine_make_handle
  assign current_tag_joined = current_tags | join: ',' | downcase
-%}

{%- style -%}
  .hi-machine-hub{--hi-accent:{{ accent }};background:#fff;color:#151515;border-bottom:1px solid #e8e8e8}
  .hi-machine-hub__wrap{max-width:1180px;margin:0 auto;padding:28px 18px 18px}
  .hi-machine-hub__crumbs{display:flex;flex-wrap:wrap;gap:7px;align-items:center;margin:0 0 14px;font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;color:#6b7280}
  .hi-machine-hub__crumbs a{color:#6b7280;text-decoration:none}.hi-machine-hub__crumbs a:hover{color:#111}.hi-machine-hub__sep{color:#c7c7c7}
  .hi-machine-hub__eyebrow{font-weight:900;text-transform:uppercase;letter-spacing:.12em;color:var(--hi-accent);font-size:.75rem;margin:0 0 8px}
  .hi-machine-hub__title{font-size:clamp(1.75rem,3.5vw,3rem);line-height:1.05;text-transform:uppercase;letter-spacing:-.035em;margin:0;font-weight:900}
  .hi-machine-hub__sub{max-width:820px;color:#5f6b7a;font-size:1rem;line-height:1.55;margin:12px 0 0}
  .hi-machine-hub__tabs{display:flex;gap:8px;overflow-x:auto;margin:22px 0 0;padding-bottom:4px;-webkit-overflow-scrolling:touch}
  .hi-machine-hub__tab{white-space:nowrap;border:1px solid #d6d6d6;border-radius:999px;padding:9px 14px;text-decoration:none;color:#181818;background:#fff;font-size:.86rem;font-weight:800;line-height:1}
  .hi-machine-hub__tab:hover{border-color:#111}.hi-machine-hub__tab.is-active{background:#181818;color:#fff;border-color:#181818}.hi-machine-hub__tab.is-yellow{background:var(--hi-accent);border-color:var(--hi-accent);color:#111}
  @media (max-width:749px){.hi-machine-hub__wrap{padding:22px 14px 14px}.hi-machine-hub__tabs{gap:6px}.hi-machine-hub__tab{font-size:.8rem;padding:8px 12px}}
{%- endstyle -%}

<section class="hi-machine-hub">
  <div class="hi-machine-hub__wrap">
    <nav class="hi-machine-hub__crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a><span class="hi-machine-hub__sep">/</span>
      {%- if machine_make != blank -%}
        <a href="{{ make_collection_url }}">{{ machine_make }}</a>
      {%- endif -%}
      {%- if is_machine -%}
        <span class="hi-machine-hub__sep">/</span><span>{{ machine_model }}</span>
      {%- endif -%}
    </nav>

    <p class="hi-machine-hub__eyebrow">Machine-Matched Parts</p>
    <h1 class="hi-machine-hub__title">{{ collection.title }}</h1>
    <p class="hi-machine-hub__sub">
      {%- if collection.description != blank -%}
        {{ collection.description | strip_html }}
      {%- elsif is_machine -%}
        Guaranteed-fit rubber tracks, sprockets, rollers, idlers, and attachments for {{ machine_make }} {{ machine_model }} machines.
      {%- else -%}
        Shop {{ machine_make }} rubber tracks, undercarriage parts, and attachments organized by machine model.
      {%- endif -%}
    </p>

    {%- if is_machine -%}
      <div class="hi-machine-hub__tabs" aria-label="Part type filters">
        <a class="hi-machine-hub__tab{% if current_tags == blank %} is-active is-yellow{% endif %}" href="{{ base_url }}">All Parts</a>
        <a class="hi-machine-hub__tab{% if current_tag_joined contains 'rubber-tracks' %} is-active{% endif %}" href="{{ base_url }}/rubber-tracks">Rubber Tracks</a>
        <a class="hi-machine-hub__tab{% if current_tag_joined contains 'drive-sprockets' %} is-active{% endif %}" href="{{ base_url }}/drive-sprockets">Sprockets</a>
        <a class="hi-machine-hub__tab{% if current_tag_joined contains 'rollers' %} is-active{% endif %}" href="{{ base_url }}/rollers">Rollers</a>
        <a class="hi-machine-hub__tab{% if current_tag_joined contains 'idlers' %} is-active{% endif %}" href="{{ base_url }}/idlers">Idlers</a>
        <a class="hi-machine-hub__tab{% if current_tag_joined contains 'attachments' %} is-active{% endif %}" href="{{ base_url }}/attachments">Attachments</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Machine collection hub",
  "settings": [
    {"type":"color","id":"accent_color","label":"Accent color","default":"#FFB607"}
  ],
  "presets": [{"name":"Machine collection hub"}]
}
{% endschema %}
